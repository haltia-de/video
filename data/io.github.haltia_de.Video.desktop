[Desktop Entry]
Type=Application
Name=Video
Name[ru]=Видео
Comment=Videos from YouTube and VK Video
Comment[ru]=Видео с YouTube и VK Видео
Exec=haltia-video
Icon=io.github.haltia_de.Video
