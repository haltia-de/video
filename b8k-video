    def set_enabled(self, src, on):
        disabled = [i for i in self.config["disabled"] if i != src.id]
        if not on:
            disabled.append(src.id)
        if disabled == self.config["disabled"]:
            return
        self.config["disabled"] = disabled
        save_json(CONFIG, self.config)
        self.update_scope()
        if on:
            # What it missed while off.
            self.feed_time = 0
            self.home_time.pop(src.id, None)

    def login_start(self, src, sub, tries=0):
        sub["login"][src.id] = {"note": "Получаю код…", "tries": tries}
        self.show_settings()
        self.work(src.login_start, done=lambda got, error: self._login_code(src, sub, got, error))

    def _login_code(self, src, sub, got, error):
        state = sub["login"].get(src.id)
        if state is None:
            return
        if error:
            state.update(note="Не удалось получить код: нет связи?")
        else:
            state.update(got, note="")
            GLib.timeout_add(LOGIN_POLL_MS, self._login_tick, src, sub, state)
        if self.sub is sub:
            self.show_settings()

    def _login_tick(self, src, sub, state):
        # Asks while Настройки with this code is on show, then stops.
        if self.sub is not sub or sub["login"].get(src.id) is not state:
            return False
        self.work(src.login_poll, done=lambda acc, error: self._login_polled(src, sub, state,
                                                                             acc, error))
        return False

    def _login_polled(self, src, sub, state, account, error):
        if self.sub is not sub or sub["login"].get(src.id) is not state:
            return
        if error:
            # The code lives a few minutes: a new one, as a TV shows.
            if state["tries"] + 1 < LOGIN_RETRIES:
                self.login_start(src, sub, state["tries"] + 1)
            else:
                sub["login"][src.id] = {"note": "Код устарел."}
                self.show_settings()
            return
        if account is None:
            GLib.timeout_add(LOGIN_POLL_MS, self._login_tick, src, sub, state)
            return
        sub["login"][src.id] = {"note": "Подписаться на каналы аккаунта можно кнопкой ниже."}
        self.after_login(src)
        self.show_settings()

    def login_check(self, src, sub):
        sub["login"][src.id] = {"note": "Проверяю…"}
        self.show_settings()

        def done(account, error):
            if error or not account:
                text = "Войти не удалось: файла нет, он устарел или нет связи."
            else:
                text = "Подписаться на каналы аккаунта можно кнопкой ниже."
                self.after_login(src)
            sub["login"][src.id] = {"note": text}
            if self.sub is sub:
                self.show_settings()

        self.work(src.login_check, done=done)

    def after_login(self, src):
        # Главная of a signed-in source is the account's own.
        self.home_time.pop(src.id, None)
        self.searches.clear()

    def logout(self, src, sub):
        def worker():
            if ask(src.label, "Выйти из аккаунта"):
                GLib.idle_add(done)

        def done():
            src.logout()
            sub["login"].pop(src.id, None)
            self.after_login(src)
            self.home.pop(src.id, None)
            if self.sub is sub:
                self.show_settings()
            return False

        threading.Thread(target=worker, daemon=True).start()

    def import_subscriptions(self, src, sub):
        sub["login"][src.id] = {"note": "Загружаю каналы аккаунта…"}
        self.show_settings()

        def done(chans, error):
            if error:
                text = "Не удалось загрузить каналы: нет связи?"
            else:
                new = [c for c in chans or [] if not self.is_followed(c["source"], c["id"])]
                for chan in new:
                    self.follow(chan)
                text = ("Добавлено каналов: %d." % len(new)) if new else \
                    "Все каналы аккаунта уже здесь."
            sub["login"][src.id] = {"note": text}
            if self.sub is sub:
                self.show_settings()

        self.work(src.subscriptions, done=done)

    # --- channels ---------------------------------------------------------
    def is_followed(self, source, cid):
        return any(c["id"] == cid and c["source"] == source for c in self.config["channels"])

    def followed(self, video):
        return self.is_followed(video["source"], video.get("channel_id"))

    def follow_menu(self, video):
        if not video.get("channel_id"):
            return
        name = video.get("channel") or "канал"

        def worker():
            if self.followed(video):
                yes = ask("«%s»" % name, "Отписаться от канала")
                if yes:
                    GLib.idle_add(self.unfollow, {"source": video["source"],
                                                  "id": video["channel_id"]})
            else:
                yes = ask("«%s»" % name, "Подписаться на канал")
                if yes:
                    GLib.idle_add(self.follow, {"source": video["source"],
                                                "id": video["channel_id"], "title": name})

        threading.Thread(target=worker, daemon=True).start()

    def follow(self, chan):
        chans = [c for c in self.config["channels"]
                 if not (c["id"] == chan["id"] and c["source"] == chan["source"])]
        chan = dict(chan)
        if chan.get("thumb") or chan.get("subscribers") is not None:
            chan["updated"] = time.time()  # found with its details
        chans.append(chan)
        self.config["channels"] = chans
        save_json(CONFIG, self.config)
        self.feed_time = 0
        return False

    def unfollow(self, chan):
        self.config["channels"] = [c for c in self.config["channels"]
                                   if not (c["id"] == chan["id"]
                                           and c["source"] == chan["source"])]
        save_json(CONFIG, self.config)
        self.feed = [v for v in self.feed
                     if not (v.get("channel_id") == chan["id"] and v["source"] == chan["source"])]
        self.redraw("channels")
        return False

    # --- playing ----------------------------------------------------------
    def play(self, video):
        src = self.sources.get(video["source"])
        if not src:
            return
        url = src.watch_url(video)
        self.history = [video] + [v for v in self.history
                                  if not (v["id"] == video["id"] and v["source"] == video["source"])]
        del self.history[HISTORY_MAX:]
        save_json(HISTORY, self.history)
        raw = getattr(src, "ytdl_options", dict)()
        if os.access(PLAYER, os.X_OK):
            cmd = [PLAYER, "--title", video["title"], url]
            if raw:
                # Replaces the player's own list, so its runtime goes too.
                raw = dict({"js-runtimes": "quickjs"}, **raw)
                cmd.append("ytdl-raw-options=" + ",".join("%s=%s" % kv for kv in raw.items()))
        else:
            cmd = ["mpv", "--fs", "--force-media-title=" + video["title"], url]
            if raw:
                cmd.append("--ytdl-raw-options=" + ",".join("%s=%s" % kv for kv in raw.items()))
        try:
            subprocess.Popen(cmd, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self.say("Нет проигрывателя (b8k-vplay или mpv).")

    # --- background work --------------------------------------------------
    def work(self, func, *args, done):
        """func(*args) on a worker; done(result, error) back on the GTK side."""

        def worker():
            try:
                res, err = func(*args), None
            except Exception as exc:
                sys.stderr.write("b8k-video: %s\n" % exc)
                res, err = None, exc

            def back():
                done(res, err)
                return False

            GLib.idle_add(back)

        self.pool.submit(worker)


if __name__ == "__main__":
    sys.exit(Video().run(sys.argv))
