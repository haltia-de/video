            btn.get_style_context().add_class("add")
            btn.connect("clicked", lambda _b: (self.follow(chan), self.redraw_sub(sub)))
        return btn

    def redraw_sub(self, sub):
        if self.sub is sub:
            keep_scroll(self.scroll, lambda: self.show_results(sub))

