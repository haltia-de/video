    # --- search -----------------------------------------------------------
    def search(self, query=None):
        """Videos from every source in scope at once, YouTube's first,
        each source shown as soon as it answers."""
        query = (query or self.entry.get_text()).strip()
        if not query:
            return
        self.entry.select_region(0, 0)
        self.win.set_focus(None)  # the keyboard goes away
        self.mark_tab(None)
        self.run_search("search", query, [s for s in self.scope()], "Поиск")

    def find_channels(self, query):
        """Channels matching the words, in the sources in scope; a link
        finds its channel where it points."""
        self.win.set_focus(None)  # the keyboard goes away
        owner = [s for s in self.enabled() if getattr(s, "owns", lambda _t: False)(query)]
        self.run_search("channels", query, owner[:1] or self.scope(), "Поиск каналов")

    def run_search(self, kind, query, srcs, title):
        sub = {"kind": kind, "query": query, "sources": srcs, "results": {}}
        self.open_sub(sub, title)
        now = time.time()
        for src in srcs:
            kept = self.searches.get((kind, src.id, query))
            if kept and now - kept[0] < SEARCH_KEEP_SEC:
                sub["results"][src.id] = kept[1]
                continue
            func = src.search if kind == "search" else src.search_channels
            self.work(func, query,
                      done=lambda res, error, s=src: self._search_ready(sub, s, res, error))
        self.show_results(sub)

    def _search_ready(self, sub, src, result, error):
        if not error:
            self.searches[(sub["kind"], src.id, sub["query"])] = (time.time(), result)
        sub["results"][src.id] = None if error else result
        if self.sub is sub:
            keep_scroll(self.scroll, lambda: self.show_results(sub))

    def show_results(self, sub):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        if sub["kind"] == "channels":
            box.pack_start(self.channel_finder(sub["query"]), False, False, 0)
        results = sub["results"]
        several = len(sub["sources"]) > 1
        waiting = [s.label for s in sub["sources"] if s.id not in results]
        failed = [s.label for s in sub["sources"] if s.id in results and results[s.id] is None]
        found = any(results.get(s.id) for s in sub["sources"])
        newest = sub["kind"] == "search" and self.config["sort"] == "date"
        if sub["kind"] == "search" and found:
            order = Gtk.Button(label="Сначала новые" if newest else "Сначала подходящие")
            order.get_style_context().add_class("more")
            order.set_halign(Gtk.Align.START)
            order.connect("clicked", lambda _b: self.toggle_sort(sub))
            box.pack_start(order, False, False, 0)
        if newest:
            # The sources find by relevance (asked for the newest, they
            # bring the newest of anything, matching or not): what they
            # found, all sources together, newest first.
            videos = [v for s in sub["sources"] for v in results.get(s.id) or []]
            videos.sort(key=lambda v: v.get("published") or 0, reverse=True)
            if videos:
                box.pack_start(self.grid(videos), False, False, 0)
        for src in [] if newest else sub["sources"]:
            got = results.get(src.id)
            if not got:
                continue
            if several:
                self.section(box, src.label)
            if sub["kind"] == "search":
                box.pack_start(self.grid(got), False, False, 0)
            else:
                for chan in got:
                    box.pack_start(self.channel_row(chan, self.follow_button(chan, sub)),
                                   False, False, 0)
        notes = []
        if waiting:
            notes.append("Ищу «%s» (%s)…" % (sub["query"], ", ".join(waiting)))
        if failed:
            notes.append("Не удалось: %s — нет связи?" % ", ".join(failed))
        if not waiting and not found and not failed:
            notes.append("Ничего не найдено." if sub["kind"] == "search"
                         else "Каналы не найдены.")
        self.say(" ".join(notes))
        self.set_content(box)

    def toggle_sort(self, sub):
        self.config["sort"] = "relevance" if self.config["sort"] == "date" else "date"
        save_json(CONFIG, self.config)
        if self.sub is sub:
            self.show_results(sub)

    def follow_button(self, chan, sub):
        if self.is_followed(chan["source"], chan["id"]):
            btn = Gtk.Button(label="Отписаться")
            btn.get_style_context().add_class("drop")
            btn.get_style_context().add_class("wide")
