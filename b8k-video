    def set_enabled(self, src, on):
        if self.library.set_enabled(src.id, on) and on:
            # What it missed while off.
            self.feed.invalidate()
            self.home.invalidate(src.id)

    def _signin_changed(self, src, state):
        now = state["kind"] == "in"
        if now != self.signed_in.get(src.id):
            self.signed_in[src.id] = now
            # Главная and searches of a signed-in source are the account's own.
            self.home.forget(src.id)
            self.searches.forget()
            self.account_notes[src.id] = (
                "Подписаться на каналы аккаунта можно кнопкой ниже." if now else None)
        if self.on_sub("settings"):
            self.show_settings()

    def logout(self, src):
        def worker():
            if ask(src.label, "Выйти из аккаунта"):
                GLib.idle_add(lambda: self.signins[src.id].logout() and False)

        threading.Thread(target=worker, daemon=True).start()

    def import_subscriptions(self, src):
        def note(text):
            self.account_notes[src.id] = text
            if self.on_sub("settings"):
                self.show_settings()

        def done(chans, error):
            if error:
                note("Не удалось загрузить каналы: нет связи?")
            else:
                new = self.library.follow_all(chans or [])
                note(("Добавлено каналов: %d." % new) if new
                     else "Все каналы аккаунта уже здесь.")

        note("Загружаю каналы аккаунта…")
        self.work(src.subscriptions, done=done)

    # --- channels ---------------------------------------------------------
    def library_changed(self, what):
        if what == "position":
            state = self.player.state
            if state is None or state["paused"]:
                self.redraw(self.page)  # the strips on the cards; not while one watches
        elif what == "follow":
            self.feed.invalidate()  # the new channels' videos are not in it yet
        elif what in ("unfollow", "details"):
            self.redraw(self.page)  # Каналы, and a feed without the channel
        elif what == "settings":
            self.update_scope()

    def follow_menu(self, video):
        if not video.get("channel_id"):
            return
        name = video.get("channel") or "канал"

        source, cid = video["source"], video["channel_id"]

        def worker():
            if self.library.is_followed(source, cid):
                if ask("«%s»" % name, "Отписаться от канала"):
                    GLib.idle_add(lambda: self.library.unfollow(source, cid) and False)
            elif ask("«%s»" % name, "Подписаться на канал"):
                GLib.idle_add(lambda: self.library.follow({"source": source, "id": cid,
                                                           "title": name}) and False)

        threading.Thread(target=worker, daemon=True).start()

    # --- playing ----------------------------------------------------------
    def play(self, video):
        src = self.sources.get(video["source"])
        if not src:
            return
        self.library.played(video)
        try:
            self.player.open(video, src.watch_url(video), start=self.library.resume_at(video),
                             ytdl=getattr(src, "ytdl_options", dict)())
        except OSError:
            self.say("Нет проигрывателя (b8k-vplay или mpv).")

