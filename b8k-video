    def refresh_channels(self):
        """Ask again, in the background, about followed channels known only
        by name (followed from a card) or whose details are a week old."""
        if self.refreshing:
            return
        now = time.time()
        stale = [c for c in self.config["channels"]
                 if now - c.get("updated", 0) > CHANNEL_INFO_SEC
                 and self.is_enabled(c["source"])
                 and (c["source"], c["id"]) not in self.refresh_tried]
        if not stale:
            return
        self.refreshing = True
        self.refresh_tried.update((c["source"], c["id"]) for c in stale)
        self.work(self._load_channel_info, stale, done=self._channel_info_ready)

    def _load_channel_info(self, chans):
        def one(chan):
            try:
                info = self.sources[chan["source"]].find_channel(chan["id"])
            except Exception as exc:
                sys.stderr.write("b8k-video: %s: %s\n" % (chan.get("title"), exc))
                return None
            return info if info and info["id"] == chan["id"] else None

        with ThreadPoolExecutor(max_workers=NET_WORKERS) as pool:
            return [info for info in pool.map(one, chans) if info]

    def _channel_info_ready(self, infos, error):
        self.refreshing = False
        if not infos:
            return
        now = time.time()
        for info in infos:
            for chan in self.config["channels"]:
                if chan["id"] == info["id"] and chan["source"] == info["source"]:
                    chan.update(info, updated=now)
        save_json(CONFIG, self.config)
        self.redraw("channels")

    def show_channel(self, chan):
        self.open_sub({"kind": "channel", "chan": chan}, chan["title"])
        key = (chan["source"], chan["id"])
        kept = self.channel_videos.get(key)
        if kept and time.time() - kept[0] < CHANNEL_KEEP_SEC:
            self.say("" if kept[1] else "У канала пока нет видео.")
            self.set_content(self.grid(kept[1]))
            return
        self.say("Загружаю…")
        self.set_content(Gtk.Box())
        src = self.sources.get(chan["source"])
        if src:
            self.work(src.channel_videos, chan,
                      done=lambda videos, error: self._channel_ready(chan, videos, error))

    def _channel_ready(self, chan, videos, error):
        if not error:
            self.channel_videos[(chan["source"], chan["id"])] = (time.time(), videos)
        if not self.on_sub("channel", chan=chan):
            return
        if error:
            self.say("Не удалось загрузить: нет связи?")
            return
        self.say("" if videos else "У канала пока нет видео.")
        self.set_content(self.grid(videos))

