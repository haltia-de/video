def buzzer():
    return b8k_ui.Buzz() if b8k_ui else (lambda *_a: True)


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(path + ".new", path)


def ask(question, yes):
    if b8k_ui:
        return b8k_ui.ask(question, yes)
    return True


def nice_duration(sec):
    if not sec:
        return ""
    sec = int(sec)
    if sec >= 3600:
        return "%d:%02d:%02d" % (sec // 3600, sec // 60 % 60, sec % 60)
    return "%d:%02d" % (sec // 60, sec % 60)


def plural(n, one, few, many):
    if n % 10 == 1 and n % 100 != 11:
        return one
    if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14:
        return few
    return many


def nice_subscribers(n):
    if n is None:
        return ""
    if n >= 1000:
        num, unit = (n / 1e6, "млн") if n >= 10 ** 6 else (n / 1e3, "тыс.")
        text = ("%d" % num) if num >= 100 else ("%.1f" % num).rstrip("0").rstrip(".")
        return "%s %s подписчиков" % (text.replace(".", ","), unit)
    return "%d %s" % (n, plural(n, "подписчик", "подписчика", "подписчиков"))


def nice_age(ts):
    if not ts:
        return ""
    days = int((time.time() - ts) // 86400)
    if days <= 0:
        hours = max(1, int((time.time() - ts) // 3600))
        return "%d ч назад" % hours
    if days < 30:
        return "%d дн назад" % days
    return time.strftime("%d.%m.%Y", time.localtime(ts))


class Thumbs:
    """Card pictures, fetched by a few workers and kept on disk."""

    def __init__(self):
        self.pool = ThreadPoolExecutor(max_workers=3)
        os.makedirs(CACHE, exist_ok=True)

    def get(self, url, image, size=(THUMB_W, THUMB_H)):
        name = hashlib.sha1(url.encode()).hexdigest() + ".jpg"
        path = os.path.join(CACHE, name)
        if os.path.exists(path):
            self._show(path, image, size)
            return
        self.pool.submit(self._fetch, url, path, image, size)

    def _fetch(self, url, path, image, size):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = resp.read(512 * 1024)
            with open(path + ".new", "wb") as fh:
                fh.write(data)
            os.replace(path + ".new", path)
        except OSError:
            return
        GLib.idle_add(self._show, path, image, size)

    @staticmethod
    def _show(path, image, size):
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size[0], size[1], True)
            image.set_from_pixbuf(pix)
        except GLib.Error:
            pass
        return False


class Video(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.Video")
        self.sources = sources.load()
        self.config = load_json(CONFIG, {"channels": []})
        self.config.setdefault("source", "youtube")
        self.history = load_json(HISTORY, [])
        self.thumbs = Thumbs()
        self.feed = []
        self.feed_time = 0
        self.page = "feed"
        self.channel = None  # the channel shown on its own page
        self.refreshing = False  # followed channels' details being fetched
        self.refresh_tried = set()
        self.win = None

    # --- layout ---------------------------------------------------------
    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.buzz = buzzer()
        # The class must exist before a hook on its signal can be added.
        GObject.type_class_ref(Gtk.Button)
        GObject.add_emission_hook(Gtk.Button, "pressed", self.buzz)
        provider = Gtk.CssProvider()
        provider.load_from_data((b8k_ui.HEADER_CSS if b8k_ui else b"") + CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.ApplicationWindow(application=self, title="Видео")
        self.win.set_default_size(1160, 800)
        header = Gtk.HeaderBar(title="Видео")
        self.back_btn = Gtk.Button(label="←")
        self.back_btn.get_style_context().add_class("back")
        self.back_btn.connect("clicked", lambda *_a: self.show_page(self.page))
        self.back_btn.set_no_show_all(True)
        header.pack_start(self.back_btn)
        self.win.set_titlebar(header)
        self.header = header

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(16)
        box.get_style_context().add_class("page")

        row = Gtk.Box(spacing=12)
        self.source_btn = Gtk.Button(label=self.source().label)
        self.source_btn.get_style_context().add_class("source")
        self.source_btn.connect("clicked", lambda *_a: self.next_source())
        if len(self.sources) > 1:
            row.pack_start(self.source_btn, False, False, 0)
        self.entry = Gtk.Entry(placeholder_text="Найти видео")
        self.entry.get_style_context().add_class("search")
        self.entry.connect("activate", lambda *_a: self.search())
        row.pack_start(self.entry, True, True, 0)
        self.find_btn = Gtk.Button(label="Найти")
        self.find_btn.get_style_context().add_class("find")
        self.find_btn.connect("clicked", lambda *_a: self.search())
        row.pack_start(self.find_btn, False, False, 0)
        box.pack_start(row, False, False, 0)

        tabs = Gtk.Box(spacing=12, homogeneous=True)
        self.tabs = {}
        for key, label in (("feed", "Подписки"), ("channels", "Каналы"),
                           ("history", "История")):
            btn = Gtk.Button(label=label)
            btn.get_style_context().add_class("tab")
            btn.connect("clicked", lambda _b, k=key: self.show_page(k))
            tabs.pack_start(btn, True, True, 0)
            self.tabs[key] = btn
        box.pack_start(tabs, False, False, 0)
        self.tabs_box = tabs

        # The note and the cards scroll together: a wrapped label outside
        # the scrolled part made the window taller than the room the
        # on-screen keyboard leaves, and the window covered its top row.
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroll.set_kinetic_scrolling(True)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.note = Gtk.Label()
        self.note.get_style_context().add_class("note")
        self.note.set_line_wrap(True)
        self.note.set_no_show_all(True)
        self.note.set_margin_top(12)
        self.body.pack_start(self.note, False, False, 0)
        self.scroll.add(self.body)
        box.pack_start(self.scroll, True, True, 0)
        self.win.add(box)
        self.win.show_all()
        # No field in focus at start, or the keyboard comes up unasked.
        self.win.set_focus(None)
        self.show_page("feed")
        # yt-dlp takes seconds to import on this CPU: do it while one types.
        threading.Thread(target=self.warm_up, daemon=True).start()

    def source(self):
        """Where searches go: the one chosen, or any there is."""
        return self.sources.get(self.config["source"]) or next(iter(self.sources.values()))

    def next_source(self):
        ids = sorted(self.sources, key=lambda k: self.sources[k].label.lower() != "youtube")
        now = self.source().id
        self.config["source"] = ids[(ids.index(now) + 1) % len(ids)] if now in ids else ids[0]
        save_json(CONFIG, self.config)
        self.source_btn.set_label(self.source().label)
        # A search on show is redone where it now goes.
        if self.channel and "search" in self.channel:
            self.search(self.channel["search"])
        elif self.channel and "channels" in self.channel:
            self.find_channels(self.channel["channels"])

    def warm_up(self):
        for src in self.sources.values():
            try:
                getattr(src, "warm_up", lambda: None)()
            except Exception:
                pass

    def say(self, text):
        if text:
            self.note.set_text(text)
            self.note.show()
        else:
            self.note.hide()

    def set_content(self, widget):
        for child in self.body.get_children():
            if child is not self.note:
                self.body.remove(child)
                child.destroy()
        self.body.pack_start(widget, False, False, 0)
        self.scroll.get_vadjustment().set_value(0)
        widget.show_all()

    def mark_tab(self, key):
        for k, btn in self.tabs.items():
            ctx = btn.get_style_context()
            (ctx.add_class if k == key else ctx.remove_class)("current")

    # --- cards ------------------------------------------------------------
    def grid(self, videos):
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=3, min_children_per_line=3,
                           row_spacing=16, column_spacing=16)
        flow.set_valign(Gtk.Align.START)
        for video in videos:
            flow.add(self.card(video))
        return flow

    def card(self, video):
        ev = Gtk.EventBox()
        ev.get_style_context().add_class("card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        image = Gtk.Image()
        image.set_size_request(THUMB_W, THUMB_H)
        box.pack_start(image, False, False, 0)
        title = Gtk.Label(label=video["title"], xalign=0)
        title.set_line_wrap(True)
        title.set_lines(2)
        title.set_ellipsize(3)  # Pango.EllipsizeMode.END
        title.set_max_width_chars(28)
        title.get_style_context().add_class("ttl")
        title.set_margin_start(12)
        title.set_margin_end(12)
        box.pack_start(title, False, False, 0)
        bits = [video.get("channel") or "", nice_duration(video.get("duration")),
                nice_age(video.get("published"))]
        sub = Gtk.Label(label=" · ".join(b for b in bits if b), xalign=0)
        sub.set_ellipsize(3)
        sub.get_style_context().add_class("sub")
        sub.set_margin_start(12)
        sub.set_margin_end(12)
        box.pack_start(sub, False, False, 0)
        ev.add(box)
        self.thumbs.get(video["thumb"], image)

        # A tap plays; a long press follows or unfollows the channel.
        tap = Gtk.GestureMultiPress(widget=ev)
        hold = Gtk.GestureLongPress(widget=ev)
        hold.set_property("delay-factor", 1.2)
        ev._gestures = (tap, hold)  # keep them alive with the widget
        state = {"held": False}
        tap.connect("pressed", lambda *_a: state.update(held=False))
        tap.connect("released", lambda *_a: None if state["held"] else self.play(video))
        hold.connect("pressed", lambda *_a: (state.update(held=True), self.follow_menu(video)))
        return ev

    # --- pages ------------------------------------------------------------
    def show_page(self, key):
        self.page = key
        self.channel = None
        self.back_btn.hide()
        self.header.set_title("Видео")
        self.mark_tab(key)
        self.say("")
        if key == "feed":
            self.show_feed()
        elif key == "channels":
            self.show_channels()
        else:
            self.show_history()

    def show_feed(self):
        if self.feed and time.time() - self.feed_time < FEED_REFRESH_SEC:
            self.set_content(self.grid(self.feed))
            return
        chans = self.config.get("channels", [])
        if not chans:
            self.set_content(Gtk.Box())
            self.say("Здесь будут новые видео каналов, на которые вы подписаны. "
                     "Найдите видео и подержите палец на нём, чтобы подписаться "
                     "на канал, или добавьте канал на странице «Каналы».")
            return
        self.say("Загружаю новые видео…")
        self.set_content(self.grid(self.feed))
        self.work(self._load_feed, chans, done=self._feed_ready)

    def _load_feed(self, chans):
        out = []
        latest = {}  # (source, id): the time of the channel's newest video
        for chan in chans:
            src = self.sources.get(chan.get("source"))
            if not src:
                continue
            try:
                videos = src.channel_videos(chan)
            except Exception as exc:
                sys.stderr.write("b8k-video: %s: %s\n" % (chan.get("title"), exc))
                continue
            out.extend(videos)
            times = [v["published"] for v in videos if v.get("published")]
            if times:
                latest[(chan["source"], chan["id"])] = max(times)
        out.sort(key=lambda v: v.get("published") or 0, reverse=True)
        return out[:FEED_MAX], latest

    def _feed_ready(self, result, error):
        if error or result is None:
            if self.page == "feed":
                self.say("Не удалось загрузить: нет связи?")
            return
        videos, latest = result
        # Kept with the channels, so that Каналы can tell it before the
        # feed is loaded again.
        changed = False
        for chan in self.config.get("channels", []):
            when = latest.get((chan["source"], chan["id"]))
            if when and when != chan.get("latest"):
                chan["latest"] = when
                changed = True
        if changed:
            save_json(CONFIG, self.config)
        self.feed = videos
        self.feed_time = time.time()
        if self.page == "feed" and not self.channel:
            self.say("" if videos else "У каналов пока нет видео.")
            self.set_content(self.grid(videos))

    def show_channels(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.channel_finder(), False, False, 0)
        for chan in self.config.get("channels", []):
            drop = Gtk.Button(label="✕")
            drop.get_style_context().add_class("drop")
            drop.connect("clicked", lambda _b, c=chan: self.unfollow(c))
            box.pack_start(self.channel_row(chan, drop), False, False, 0)
        if not self.config.get("channels"):
            self.say("Подписок пока нет. Найдите канал по названию или "
                     "вставьте ссылку на него.")
        self.set_content(box)
        self.refresh_channels()

    def channel_finder(self, text=""):
        row = Gtk.Box(spacing=12)
        entry = Gtk.Entry(placeholder_text="Найти канал, ссылка или @имя", text=text)
        entry.get_style_context().add_class("search")
        row.pack_start(entry, True, True, 0)
        btn = Gtk.Button(label="Найти")
        btn.get_style_context().add_class("add")
        row.pack_start(btn, False, False, 0)

        def do_find(*_a):
            query = entry.get_text().strip()
            if query:
                self.find_channels(query)

        entry.connect("activate", do_find)
        btn.connect("clicked", do_find)
        return row

    def channel_row(self, chan, action):
        """A channel with what is known about it; a tap opens it, action
        (a button) sits at the end."""
        row = Gtk.Box(spacing=12)
        row.get_style_context().add_class("chan")
        inner = Gtk.Box(spacing=16)
        avatar = Gtk.Image()
        avatar.set_size_request(AVATAR, AVATAR)
        avatar.set_valign(Gtk.Align.START)
        if chan.get("thumb"):
            self.thumbs.get(chan["thumb"], avatar, (AVATAR, AVATAR))
        inner.pack_start(avatar, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        text.set_valign(Gtk.Align.CENTER)
        name = Gtk.Label(label=chan["title"], xalign=0)
        name.set_ellipsize(3)  # Pango.EllipsizeMode.END
        name.get_style_context().add_class("cname")
        text.pack_start(name, False, False, 0)
        latest = nice_age(chan.get("latest"))
        src = self.sources.get(chan["source"])
        bits = [src.label if src and len(self.sources) > 1 else "",
                chan.get("handle") or "", nice_subscribers(chan.get("subscribers")),
                ("новое видео " + latest) if latest else ""]
        bits = [b for b in bits if b]
        if bits:
            sub = Gtk.Label(label=" · ".join(bits), xalign=0)
            sub.set_ellipsize(3)
            sub.get_style_context().add_class("csub")
            text.pack_start(sub, False, False, 0)
        if chan.get("description"):
            desc = Gtk.Label(label=chan["description"], xalign=0)
            desc.set_line_wrap(True)
            desc.set_lines(2)
            desc.set_ellipsize(3)
            desc.set_max_width_chars(60)
            desc.get_style_context().add_class("cdesc")
            text.pack_start(desc, False, False, 0)
        inner.pack_start(text, True, True, 0)
        open_btn = Gtk.Button()
        open_btn.get_style_context().add_class("open")
        open_btn.add(inner)
        open_btn.connect("clicked", lambda _b: self.show_channel(chan))
        row.pack_start(open_btn, True, True, 0)
        action.set_valign(Gtk.Align.CENTER)
        row.pack_start(action, False, False, 0)
        return row

    def find_channels(self, query):
        """Channels matching the words, in the source chosen; a link finds
        its channel where it points."""
        self.win.set_focus(None)  # the keyboard goes away
        src = next((s for s in self.sources.values()
                    if getattr(s, "owns", lambda _t: False)(query)), self.source())
        self.channel = {"channels": query, "source": src}
        self.header.set_title("Поиск каналов")
        self.back_btn.show()
        self.say("Ищу каналы «%s» (%s)…" % (query, src.label))
        self.set_content(self.channel_finder(query))
        self.work(src.search_channels, query,
                  done=lambda chans, error: self._channels_found(query, src, chans, error))

    def _channels_found(self, query, src, chans, error):
        if (not self.channel or self.channel.get("channels") != query
                or self.channel.get("source") is not src):
            return  # left, or another search began
        if error:
            self.say("Поиск не удался: нет связи?")
            return
        self.channel["found"] = chans
        self.say("" if chans else "Каналы не найдены.")
        self.show_found()

    def show_found(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.channel_finder(self.channel["channels"]), False, False, 0)
        for chan in self.channel["found"]:
            if self.is_followed(chan["source"], chan["id"]):
                btn = Gtk.Button(label="Отписаться")
                btn.get_style_context().add_class("drop")
                btn.get_style_context().add_class("wide")
                btn.connect("clicked", lambda _b, c=chan: (self.unfollow(c), self.show_found()))
            else:
                btn = Gtk.Button(label="Подписаться")
                btn.get_style_context().add_class("add")
                btn.connect("clicked", lambda _b, c=chan: (self.follow(c), self.show_found()))
            box.pack_start(self.channel_row(chan, btn), False, False, 0)
        value = self.scroll.get_vadjustment().get_value()
        self.set_content(box)
        self.scroll.get_vadjustment().set_value(value)  # stay at the row tapped

    def refresh_channels(self):
        """Ask again, in the background, about followed channels known only
        by name (followed from a card) or whose details are a week old."""
        if self.refreshing:
            return
        now = time.time()
        stale = [c for c in self.config.get("channels", [])
                 if now - c.get("updated", 0) > CHANNEL_INFO_SEC
                 and (c["source"], c["id"]) not in self.refresh_tried]
        if not stale:
            return
        self.refreshing = True
        self.refresh_tried.update((c["source"], c["id"]) for c in stale)
        self.work(self._load_channel_info, stale, done=self._channel_info_ready)

    def _load_channel_info(self, chans):
        out = []
        for chan in chans:
            src = self.sources.get(chan["source"])
            try:
                info = src and src.find_channel(chan["id"])
            except Exception as exc:
                sys.stderr.write("b8k-video: %s: %s\n" % (chan.get("title"), exc))
                continue
            if info and info["id"] == chan["id"]:
                out.append(info)
        return out

    def _channel_info_ready(self, infos, error):
        self.refreshing = False
        if not infos:
            return
        now = time.time()
        for info in infos:
            for chan in self.config.get("channels", []):
                if chan["id"] == info["id"] and chan["source"] == info["source"]:
                    chan.update(info, updated=now)
        save_json(CONFIG, self.config)
        if self.page == "channels" and not self.channel:
            value = self.scroll.get_vadjustment().get_value()
            self.show_page("channels")
            self.scroll.get_vadjustment().set_value(value)

    def show_channel(self, chan):
        self.channel = chan
        self.header.set_title(chan["title"])
        self.back_btn.show()
        self.say("Загружаю…")
        self.set_content(Gtk.Box())
        src = self.sources.get(chan.get("source"))
        if src:
            self.work(src.channel_videos, chan, done=self._channel_ready)

    def _channel_ready(self, videos, error):
        if not self.channel:
            return
        if error:
            self.say("Не удалось загрузить: нет связи?")
            return
        self.say("" if videos else "У канала пока нет видео.")
        self.set_content(self.grid(videos))

    def show_history(self):
        self.say("" if self.history else "Здесь будут видео, которые вы смотрели.")
        self.set_content(self.grid(self.history))

    # --- search -----------------------------------------------------------
    def search(self, query=None):
        query = (query or self.entry.get_text()).strip()
        if not query:
            return
        self.entry.select_region(0, 0)
        self.win.set_focus(None)  # the keyboard goes away
        self.channel = {"search": query}
        self.header.set_title("Поиск")
        self.back_btn.show()
        self.mark_tab(None)
        src = self.source()
        self.say("Ищу «%s» (%s)…" % (query, src.label))
        self.set_content(Gtk.Box())
        self.work(src.search, query,
                  done=lambda videos, error: self._search_ready(query, src, videos, error))

    def _search_ready(self, query, src, videos, error):
        if (not self.channel or self.channel.get("search") != query
                or src is not self.source()):
            return  # left, or another search began
        if error:
            self.say("Поиск не удался: нет связи?")
            return
        self.say("" if videos else "Ничего не найдено.")
        self.set_content(self.grid(videos))

    # --- channels -----------------------------------------------------------
    def is_followed(self, source, cid):
        return any(c["id"] == cid and c["source"] == source
                   for c in self.config.get("channels", []))

    def followed(self, video):
        return self.is_followed(video["source"], video.get("channel_id"))

    def follow_menu(self, video):
        if not video.get("channel_id"):
            return
        name = video.get("channel") or "канал"

        def worker():
            if self.followed(video):
                yes = ask("«%s»" % name, "Отписаться от канала")
                if yes:
                    GLib.idle_add(self.unfollow, {"source": video["source"],
                                                  "id": video["channel_id"]})
            else:
                yes = ask("«%s»" % name, "Подписаться на канал")
                if yes:
                    GLib.idle_add(self.follow, {"source": video["source"],
                                                "id": video["channel_id"], "title": name})

        threading.Thread(target=worker, daemon=True).start()

    def follow(self, chan):
        chans = [c for c in self.config.get("channels", [])
                 if not (c["id"] == chan["id"] and c["source"] == chan["source"])]
        chan = dict(chan)
        if chan.get("thumb") or chan.get("subscribers") is not None:
            chan["updated"] = time.time()  # found with its details
        chans.append(chan)
        self.config["channels"] = chans
        save_json(CONFIG, self.config)
        self.feed_time = 0
        return False

    def unfollow(self, chan):
        self.config["channels"] = [c for c in self.config.get("channels", [])
                                   if not (c["id"] == chan["id"] and c["source"] == chan["source"])]
        save_json(CONFIG, self.config)
        self.feed = [v for v in self.feed if v.get("channel_id") != chan["id"]]
        if self.page == "channels" and not self.channel:
            self.show_page("channels")
        return False

    # --- playing ------------------------------------------------------------
    def play(self, video):
        src = self.sources.get(video["source"])
        if not src:
            return
        url = src.watch_url(video)
        self.history = [video] + [v for v in self.history
                                  if not (v["id"] == video["id"] and v["source"] == video["source"])]
        del self.history[HISTORY_MAX:]
        save_json(HISTORY, self.history)
        cmd = ([PLAYER, "--title", video["title"], url] if os.access(PLAYER, os.X_OK)
               else ["mpv", "--fs", "--force-media-title=" + video["title"], url])
        try:
            subprocess.Popen(cmd, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self.say("Нет проигрывателя (b8k-vplay или mpv).")

    # --- background work ------------------------------------------------------
    def work(self, func, arg, done):
        """func(arg) in a thread; done(result, error) back on the GTK side."""

        def worker():
            try:
                res, err = func(arg), None
            except Exception as exc:
                sys.stderr.write("b8k-video: %s\n" % exc)
                res, err = None, exc

            def back():
                done(res, err)
                return False

            GLib.idle_add(back)

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    sys.exit(Video().run(sys.argv))
