    # --- search -----------------------------------------------------------
    def search(self, query=None):
        """Videos from every source in scope at once, YouTube's first,
        each source shown as soon as it answers."""
        query = (query or self.entry.get_text()).strip()
        if not query:
            return
        self.entry.select_region(0, 0)
        self.win.set_focus(None)  # the keyboard goes away
        self.mark_tab(None)
        self.run_search("search", query, [s for s in self.scope()], "Поиск")

    def find_channels(self, query):
        """Channels matching the words, in the sources in scope; a link
        finds its channel where it points."""
        self.win.set_focus(None)  # the keyboard goes away
        owner = [s for s in self.enabled() if getattr(s, "owns", lambda _t: False)(query)]
        self.run_search("channels", query, owner[:1] or self.scope(), "Поиск каналов")

    def run_search(self, kind, query, srcs, title):
        sub = {"kind": kind, "query": query, "sources": srcs}
        self.open_sub(sub, title)
        self.show_results(sub)

    def _search(self, key):
        kind, sid, query = key
        src = self.sources[sid]
        return src.search(query) if kind == "search" else src.search_channels(query)

    def _search_came(self, key, _error):
        sub = self.sub
        if (sub and sub["kind"] == key[0] and sub["query"] == key[2]
                and key[1] in [s.id for s in sub["sources"]]):
            keep_scroll(self.scroll, lambda: self.show_results(sub))

    def show_results(self, sub):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        if sub["kind"] == "channels":
            box.pack_start(self.channel_finder(sub["query"]), False, False, 0)
        keys = {s.id: (sub["kind"], s.id, sub["query"]) for s in sub["sources"]}
        shown = search_view(
            sub["kind"], sub["query"], [(s.id, s.label) for s in sub["sources"]],
            {sid: self.searches.get(key) for sid, key in keys.items()},
            {sid for sid, key in keys.items() if self.searches.is_loading(key)},
            {sid for sid, key in keys.items() if self.searches.has_failed(key)},
            self.library.sort)
        if shown["can_sort"]:
            newest = self.library.sort == "date"
            order = Gtk.Button(label="Сначала новые" if newest else "Сначала подходящие")
            order.get_style_context().add_class("more")
            order.set_halign(Gtk.Align.START)
            order.connect("clicked", lambda _b: self.toggle_sort(sub))
            box.pack_start(order, False, False, 0)
        for section in shown["sections"]:
            if section["label"]:
                self.section(box, section["label"])
            if sub["kind"] == "search":
                box.pack_start(self.grid(section["items"]), False, False, 0)
            else:
                for chan in section["items"]:
                    box.pack_start(self.channel_row(chan, self.follow_button(chan, sub)),
                                   False, False, 0)
        self.say(shown["note"])
        self.set_content(box)

    def toggle_sort(self, sub):
        self.library.set_sort("relevance" if self.library.sort == "date" else "date")
        if self.sub is sub:
            self.show_results(sub)

    def follow_button(self, chan, sub):
        if self.library.is_followed(chan["source"], chan["id"]):
            btn = Gtk.Button(label="Отписаться")
            btn.get_style_context().add_class("drop")
            btn.get_style_context().add_class("wide")
            btn.connect("clicked", lambda _b: (self.library.unfollow(chan["source"], chan["id"]),
                                               self.redraw_sub(sub)))
        else:
            btn = Gtk.Button(label="Подписаться")
            btn.get_style_context().add_class("add")
            btn.connect("clicked", lambda _b: (self.library.follow(chan), self.redraw_sub(sub)))
        return btn

    def redraw_sub(self, sub):
        if self.sub is sub:
            keep_scroll(self.scroll, lambda: self.show_results(sub))

