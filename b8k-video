    def refresh_channels(self):
        """Ask again, in the background, about followed channels known only
        by name (followed from a card) or whose details are a week old."""
        if self.refreshing:
            return
        stale = [c for c in self.library.lacking_details()
                 if self.is_enabled(c["source"])
                 and (c["source"], c["id"]) not in self.refresh_tried]
        if not stale:
            return
        self.refreshing = True
        self.refresh_tried.update((c["source"], c["id"]) for c in stale)
        self.work(self._load_channel_info, stale, done=self._channel_info_ready)

    def _load_channel_info(self, chans):
        def one(chan):
            try:
                info = self.sources[chan["source"]].find_channel(chan["id"])
            except Exception as exc:
                sys.stderr.write("b8k-video: %s: %s\n" % (chan.get("title"), exc))
                return None
            return info if info and info["id"] == chan["id"] else None

        with ThreadPoolExecutor(max_workers=NET_WORKERS) as pool:
            return [info for info in pool.map(one, chans) if info]

    def _channel_info_ready(self, infos, error):
        self.refreshing = False
        self.library.add_details(infos or [])

    def show_channel(self, chan, again=False):
