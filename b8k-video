    scroll.get_vadjustment().set_value(value)


def qr_pixbuf(text):
    """A QR code of text as a picture, or None without the qrcode module."""
    try:
        import qrcode
    except ImportError:
        return None
    qr = qrcode.QRCode(border=2)
    qr.add_data(text)
    qr.make(fit=True)
    matrix = qr.get_matrix()
    n = len(matrix)
    scale = max(1, QR_SIZE // n)
    side = n * scale
    rows = []
    for line in matrix:
        row_bytes = bytearray()
        for dark in line:
            row_bytes += (b"\x00\x00\x00" if dark else b"\xff\xff\xff") * scale
        rows.append(bytes(row_bytes) * scale)
    data = GLib.Bytes.new(b"".join(rows))
    return GdkPixbuf.Pixbuf.new_from_bytes(data, GdkPixbuf.Colorspace.RGB, False, 8,
                                           side, side, side * 3)


class Thumbs:
    """Card pictures: fetched and decoded by a few workers (decoding a JPEG
    on the GTK side stalls the page here), kept on disk, and the decoded
    ones kept in memory too, so a page shown again needs no work at all.
    What is still queued for cards gone with their page is dropped."""

    def __init__(self):
        self.pool = ThreadPoolExecutor(max_workers=NET_WORKERS)
        self.kept = OrderedDict()  # (url, size): pixbuf, least recent first
        self.waiting = {}  # (url, size): [(image, alive)] while it is fetched
        self.lock = threading.Lock()
        os.makedirs(CACHE, exist_ok=True)

    def get(self, url, image, size=(THUMB_W, THUMB_H)):
        if not url:
            return
        key = (url, size)
        alive = [True]  # read by the workers: no GTK call off its thread
        image.connect("destroy", lambda *_a: alive.__setitem__(0, False))
        with self.lock:
            pix = self.kept.get(key)
            if pix is not None:
                self.kept.move_to_end(key)
            elif key in self.waiting:
                # Already on its way (a page drawn again): one fetch for all.
                self.waiting[key].append((image, alive))
                return
            else:
                self.waiting[key] = [(image, alive)]
        if pix is not None:
            image.set_from_pixbuf(pix)
            return
        self.pool.submit(self._load, key)

    def _load(self, key):
        with self.lock:
            if not any(alive[0] for _image, alive in self.waiting[key]):
                del self.waiting[key]  # its page is gone
                return
        url, size = key
        path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest() + ".jpg")
        pix = None
        try:
            if not os.path.exists(path):
                data = net.request(url, limit=1024 * 1024)
                with open(path + ".new", "wb") as fh:
                    fh.write(data)
                os.replace(path + ".new", path)
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size[0], size[1], True)
        except (OSError, GLib.Error):
            pass
        with self.lock:
            images = self.waiting.pop(key)
            if pix is not None:
                self.kept[key] = pix
                while len(self.kept) > PIXBUFS_KEPT:
                    self.kept.popitem(last=False)
        if pix is not None:
            GLib.idle_add(self._show, [image for image, alive in images if alive[0]], pix)

    @staticmethod
    def _show(images, pix):
        for image in images:
            image.set_from_pixbuf(pix)
        return False

    @staticmethod
    def prune():
        """Pictures not looked at for a month go, and the oldest while
        there are more than the cache may hold."""
        try:
            files = []
            for entry in os.scandir(CACHE):
                if entry.name.endswith(".jpg") and entry.is_file():
                    st = entry.stat()
                    files.append((st.st_mtime, st.st_size, entry.path))
            files.sort()
            total = sum(f[1] for f in files)
            now = time.time()
            for mtime, size, path in files:
                if total <= CACHE_MAX_BYTES and now - mtime < CACHE_MAX_AGE:
                    break
                os.remove(path)
                total -= size
        except OSError:
            pass


class Video(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.Video")
        self.sources = sources.load()
        self.library = Library()
        self.library.watch(self.library_changed)
        self.thumbs = Thumbs()
        self.pool = ThreadPoolExecutor(max_workers=WORK_WORKERS)
        # What was fetched, shown at once while it is fetched again: the
        # feed and Главная from the last start too.
        self.feed = Kept(self._load_feed, FEED_REFRESH_SEC, self.work, path=FEED_CACHE,
                         prepare=lambda _key: (self.feed_channels(),))
        self.feed.watch(self._feed_came)
        self.home = Kept(lambda sid: self.sources[sid].home(), HOME_REFRESH_SEC, self.work,
                         path=HOME_CACHE)  # by source id: {"title", "videos"} or None
        self.home.watch(lambda _key, error: error or self.redraw("home"))
        self.searches = Kept(self._search, SEARCH_KEEP_SEC, self.work)  # (kind, source, query)
        self.searches.watch(self._search_came)
        self.channel_wanted = {}  # (source, id): the channel, for its fetch
        self.channel_videos = Kept(
            lambda _key, chan: self.sources[chan["source"]].channel_videos(chan),
            CHANNEL_KEEP_SEC, self.work, prepare=lambda key: (self.channel_wanted[key],))
        self.channel_videos.watch(self._channel_came)
        self.signins = {}  # source id: its SignIn, for the sources that have one
        for src in self.sources.values():
            if getattr(src, "login", None):
                sign = SignIn(src, run=self.work, later=lambda ms, fn: GLib.timeout_add(
                    ms, lambda: (fn(), False)[1]))
                sign.watch(lambda state, src=src: self._signin_changed(src, state))
                self.signins[src.id] = sign
        self.signed_in = {sid: s.state["kind"] == "in" for sid, s in self.signins.items()}
        self.player = Player(post=lambda fn, *a: GLib.idle_add(lambda: (fn(*a), False)[1]))
        self.player.watch(self.show_bar)
        self.player.watch(self.note_position)
        self.play_last = None  # the player's state as last seen
        self.play_saved = 0  # when its position was last written down
        self.seeking = False  # a finger on the bar's slider
        self.account_notes = {}  # source id: the last word on its Account's channels
        self.page = "home"
        self.sub = None  # a page over the tabs: search, a channel, settings
        self.refreshing = False  # followed channels' details being fetched
        self.refresh_tried = set()
        self.win = None

    # --- sources ----------------------------------------------------------
    def ordered(self):
        """Every source, YouTube first."""
        return sorted(self.sources.values(), key=lambda s: (s.id != "youtube", s.label))

    def enabled(self):
        return [s for s in self.ordered() if not self.library.is_disabled(s.id)]

    def is_enabled(self, source_id):
        return source_id in self.sources and not self.library.is_disabled(source_id)

    def scope(self):
        """The sources a search goes to."""
        on = self.enabled()
        one = [s for s in on if s.id == self.library.scope]
        return one or on

    def scope_label(self):
        scope = self.scope()
        return scope[0].label if len(scope) == 1 and len(self.enabled()) > 1 else "Везде"

    def next_scope(self):
        choices = ["all"] + [s.id for s in self.enabled()]
        now = self.library.scope if self.library.scope in choices else "all"
        self.library.set_scope(choices[(choices.index(now) + 1) % len(choices)])
        # A search on show is redone where it now goes.
        if self.sub and self.sub["kind"] == "search":
            self.search(self.sub["query"])
        elif self.sub and self.sub["kind"] == "channels":
            self.find_channels(self.sub["query"])

    def update_scope(self):
        self.scope_btn.set_label(self.scope_label())
        self.scope_btn.set_visible(len(self.enabled()) > 1)

    # --- layout -----------------------------------------------------------
    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.buzz = buzzer()
        # The class must exist before a hook on its signal can be added.
        GObject.type_class_ref(Gtk.Button)
        GObject.add_emission_hook(Gtk.Button, "pressed", self.buzz)
        provider = Gtk.CssProvider()
        provider.load_from_data((b8k_ui.HEADER_CSS if b8k_ui else b"") + CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.ApplicationWindow(application=self, title="Видео")
        self.win.set_default_size(1160, 800)
        header = Gtk.HeaderBar(title="Видео")
        self.back_btn = Gtk.Button(label="←")
        self.back_btn.get_style_context().add_class("back")
        self.back_btn.connect("clicked", lambda *_a: self.show_page(self.page))
        self.back_btn.set_no_show_all(True)
        header.pack_start(self.back_btn)
        # The same gear picture as the other programs' headers.
        gear = Gtk.Button.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.DIALOG)
        gear.get_style_context().add_class("back")
        gear.connect("clicked", lambda *_a: self.show_settings())
        header.pack_end(gear)
        self.win.set_titlebar(header)
        self.header = header

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(16)
        box.get_style_context().add_class("page")

        row = Gtk.Box(spacing=12)
        self.scope_btn = Gtk.Button()
        self.scope_btn.get_style_context().add_class("source")
        self.scope_btn.connect("clicked", lambda *_a: self.next_scope())
        self.scope_btn.set_no_show_all(True)
        row.pack_start(self.scope_btn, False, False, 0)
        self.entry = Gtk.Entry(placeholder_text="Найти видео")
        self.entry.get_style_context().add_class("search")
        self.entry.connect("activate", lambda *_a: self.search())
        row.pack_start(self.entry, True, True, 0)
        find = Gtk.Button(label="Найти")
        find.get_style_context().add_class("find")
        find.connect("clicked", lambda *_a: self.search())
        row.pack_start(find, False, False, 0)
        box.pack_start(row, False, False, 0)

        tabs = Gtk.Box(spacing=12, homogeneous=True)
        self.tabs = {}
        for key, text in (("home", "Главная"), ("feed", "Подписки"),
                          ("channels", "Каналы"), ("history", "История")):
            btn = Gtk.Button(label=text)
            btn.get_style_context().add_class("tab")
            btn.connect("clicked", lambda _b, k=key: self.show_page(k))
            tabs.pack_start(btn, True, True, 0)
            self.tabs[key] = btn
        box.pack_start(tabs, False, False, 0)

        # The note and the cards scroll together: a wrapped label outside
        # the scrolled part made the window taller than the room the
        # on-screen keyboard leaves, and the window covered its top row.
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroll.set_kinetic_scrolling(True)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.note = label("", "note", wrap=True)
        self.note.set_no_show_all(True)
        self.note.set_margin_top(12)
        self.body.pack_start(self.note, False, False, 0)
        self.scroll.add(self.body)
        box.pack_start(self.scroll, True, True, 0)
        box.pack_start(self.make_bar(), False, False, 0)
        self.win.add(box)
        self.win.show_all()
        self.update_scope()
        # No field in focus at start, or the keyboard comes up unasked.
        self.win.set_focus(None)
        self.show_page("home")
        # yt-dlp takes seconds to import on this CPU: do it while one types.
        threading.Thread(target=self.warm_up, daemon=True).start()
        threading.Thread(target=Thumbs.prune, daemon=True).start()

    def warm_up(self):
        for src in self.enabled():
            try:
                getattr(src, "warm_up", lambda: None)()
            except Exception:
                pass

    def say(self, text):
        if text:
            self.note.set_text(text)
            self.note.show()
        else:
            self.note.hide()

    def set_content(self, widget):
        for child in self.body.get_children():
            if child is not self.note:
                self.body.remove(child)
                child.destroy()
        self.body.pack_start(widget, False, False, 0)
        self.scroll.get_vadjustment().set_value(0)
        widget.show_all()

    def mark_tab(self, key):
        for k, btn in self.tabs.items():
            ctx = btn.get_style_context()
            (ctx.add_class if k == key else ctx.remove_class)("current")

    def open_sub(self, sub, title):
        """A page over the tabs; the back button returns to the tab."""
        left, self.sub = self.sub, sub
        self.header.set_title(title)
        self.back_btn.show()
        self.left(left)

    def left(self, sub):
        """A page over the tabs was left: a code no one sees is not asked about."""
        if sub and sub["kind"] == "settings":
            for sign in self.signins.values():
                sign.cancel()

    def on_sub(self, kind, **match):
        """Whether that page is still the one on show (work done in the
        background checks it before showing what it brings)."""
        return (self.sub is not None and self.sub["kind"] == kind
                and all(self.sub.get(k) is v or self.sub.get(k) == v for k, v in match.items()))

    # --- cards ------------------------------------------------------------
    def grid(self, videos):
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=3, min_children_per_line=3,
                           row_spacing=16, column_spacing=16)
        flow.set_valign(Gtk.Align.START)
        for video in videos[:CARDS_AT_ONCE]:
            flow.add(self.card(video))
        rest = list(videos[CARDS_AT_ONCE:])
        if rest:
            state = {"alive": True}
            flow.connect("destroy", lambda *_a: state.update(alive=False))

            def more():
                if not state["alive"]:
                    return False
                for video in rest[:CARDS_PER_IDLE]:
                    card = self.card(video)
                    flow.add(card)
                    card.show_all()
                del rest[:CARDS_PER_IDLE]
                return bool(rest)

            GLib.idle_add(more, priority=GLib.PRIORITY_LOW)
        return flow

    def card(self, video):
        ev = Gtk.EventBox()
        ev.get_style_context().add_class("card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        image = Gtk.Image()
        image.set_size_request(THUMB_W, THUMB_H)
        picture = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        picture.pack_start(image, False, False, 0)
        seen = self.library.progress(video)
        if seen:
            # How much of it was watched, along the bottom of the picture.
            strip = Gtk.ProgressBar(fraction=seen)
            strip.set_size_request(THUMB_W, -1)
            strip.set_halign(Gtk.Align.CENTER)
            picture.pack_start(strip, False, False, 0)
        box.pack_start(picture, False, False, 0)
        title = label(video["title"], "ttl", wrap=True)
        title.set_lines(2)
        title.set_ellipsize(3)  # Pango.EllipsizeMode.END
        title.set_max_width_chars(28)
        title.set_margin_start(12)
        title.set_margin_end(12)
        box.pack_start(title, False, False, 0)
        bits = [video.get("channel") or "", nice_duration(video.get("duration")),
                nice_age(video.get("published"))]
        sub = label(" · ".join(b for b in bits if b), "sub")
        sub.set_ellipsize(3)
        sub.set_margin_start(12)
        sub.set_margin_end(12)
        box.pack_start(sub, False, False, 0)
        ev.add(box)
        self.thumbs.get(video["thumb"], image)

        # A tap plays; a long press follows or unfollows the channel.
        tap = Gtk.GestureMultiPress(widget=ev)
        hold = Gtk.GestureLongPress(widget=ev)
        hold.set_property("delay-factor", 1.2)
        ev._gestures = (tap, hold)  # keep them alive with the widget
        state = {"held": False}

        def pressed(*_a):
            # Lit and felt like a button: an event box has neither by itself.
            state["held"] = False
            ev.set_state_flags(Gtk.StateFlags.ACTIVE, False)
            self.buzz()

        tap.connect("pressed", pressed)
        tap.connect("released", lambda *_a: None if state["held"] else self.play(video))
        # Ends also when a scroll takes the finger over.
        tap.connect("end", lambda *_a: ev.unset_state_flags(Gtk.StateFlags.ACTIVE))
        hold.connect("pressed", lambda *_a: (state.update(held=True),
                                             ev.unset_state_flags(Gtk.StateFlags.ACTIVE),
                                             self.follow_menu(video)))
        return ev

