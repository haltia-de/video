def nice_duration(sec):
    if not sec:
        return ""
    sec = int(sec)
    if sec >= 3600:
        return "%d:%02d:%02d" % (sec // 3600, sec // 60 % 60, sec % 60)
    return "%d:%02d" % (sec // 60, sec % 60)


def plural(n, one, few, many):
    if n % 10 == 1 and n % 100 != 11:
        return one
    if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14:
        return few
    return many


def nice_subscribers(n):
    if n is None:
        return ""
    if n >= 1000:
        num, unit = (n / 1e6, "млн") if n >= 10 ** 6 else (n / 1e3, "тыс.")
        text = ("%d" % num) if num >= 100 else ("%.1f" % num).rstrip("0").rstrip(".")
        return "%s %s подписчиков" % (text.replace(".", ","), unit)
    return "%d %s" % (n, plural(n, "подписчик", "подписчика", "подписчиков"))


def nice_age(ts):
    if not ts:
        return ""
    days = int((time.time() - ts) // 86400)
    if days <= 0:
        hours = max(1, int((time.time() - ts) // 3600))
        return "%d ч назад" % hours
    if days < 30:
        return "%d дн назад" % days
    return time.strftime("%d.%m.%Y", time.localtime(ts))


