            self.open_sub({"kind": "channel", "chan": chan, "key": key}, chan["title"])
        if chan["source"] not in self.sources:
            return
        self.channel_wanted[key] = chan
        videos = self.channel_videos.get(key)
        if videos is None:
            self.say("Не удалось загрузить: нет связи?" if self.channel_videos.has_failed(key)
                     else "Загружаю…")
        else:
            self.say("" if videos else "У канала пока нет видео.")
        self.set_content(self.grid(videos or []))

    def _channel_came(self, key, _error):
        if self.on_sub("channel", key=key):
            self.show_channel(self.sub["chan"], again=True)

