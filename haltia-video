    def source_settings(self, src):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.get_style_context().add_class("chan")
        top = Gtk.Box(spacing=12)
        top.pack_start(label(src.label, "cname"), True, True, 0)
        switch = Gtk.Switch(active=self.is_enabled(src.id))
        switch.set_valign(Gtk.Align.CENTER)
        switch.connect("notify::active", lambda sw, _p: self.set_enabled(src, sw.get_active()))
        top.pack_start(switch, False, False, 0)
        card.pack_start(top, False, False, 0)
        sign = self.signins.get(src.id)
        if not sign:
            return card
        state = sign.state
        kind = state["kind"]
        buttons = Gtk.Box(spacing=12)

        def button(text, cls, action):
            btn = Gtk.Button(label=text)
            for c in cls.split():
                btn.get_style_context().add_class(c)
            btn.connect("clicked", lambda _b: action())
            buttons.pack_start(btn, False, False, 0)

        if kind == "in":
            card.pack_start(label("Вход выполнен: %s" % state["name"], "csub"), False, False, 0)
            button("Синхронизировать подписки", "add",
                   lambda: self.import_subscriptions(src))
            button("Выйти", "drop wide", lambda: self.logout(src))
            note = self.account_notes.get(src.id)
            if hasattr(src, "bookmark_client"):
                card.pack_start(self.bookmark_account(src.id), False, False, 0)
            else:
                card.pack_start(label("Закладки этого сервиса сохраняются только на устройстве.",
                                      "csub", wrap=True), False, False, 0)
        elif kind == "waiting":
            card.pack_start(self.login_code(state), False, False, 0)
            if hasattr(src, "login_submit"):
                button("VK показал код", "add", sign.enter_code)
            note = None
        elif kind == "code":
            card.pack_start(label("Введите код, который VK показал на телефоне "
                                  "после перехода по QR-коду.", "cdesc", wrap=True),
                            False, False, 0)
            entry = Gtk.Entry()
            entry.set_placeholder_text("Код от VK")
            entry.set_input_purpose(Gtk.InputPurpose.NUMBER)
            entry.set_activates_default(False)
            card.pack_start(entry, False, False, 0)
            button("Подтвердить", "add", lambda: sign.submit(entry.get_text()))
            entry.connect("activate", lambda ent: sign.submit(ent.get_text()))
            button("Получить новый QR-код", "wide", sign.begin)
            note = state.get("note")
        elif kind == "locked":
            note = state["note"]
            button("Открыть связку ключей", "add", sign.begin)
        else:
            if src.login == "cookies":
                # Folded: a file path and a browser extension frighten more
                # than they help someone who only wants to watch.
                # The page is redrawn as the sign-in state changes: the
                # unfolded hint is remembered, not the widget.
                hint = label(src.login_hint, "cdesc", wrap=True)
                hint.set_no_show_all(True)
                hint.set_visible(src.id in self.hints_open)
                how = Gtk.Button(label=("▾ " if src.id in self.hints_open else "▸ ") + "Как войти в %s?" % src.label)
                how.get_style_context().add_class("more")
                how.set_halign(Gtk.Align.START)

                def fold(btn, sid=src.id, hint=hint, name=src.label):
                    self.hints_open ^= {sid}
                    hint.set_visible(sid in self.hints_open)
                    btn.set_label(("▾ " if sid in self.hints_open else "▸ ") + "Как войти в %s?" % name)
                how.connect("clicked", fold)
                card.pack_start(how, False, False, 0)
                card.pack_start(hint, False, False, 0)
            note = {"getting": "Получаю код…", "checking": "Проверяю…",
                    "submitting": "Проверяю код…", "confirming": "Завершаю вход…"}.get(
                kind, state.get("note"))
            if kind in ("out", "failed"):
                # Off Flatpak, yt-dlp takes the cookies from the browser itself.
                browsers = list(src.browsers()) if hasattr(src, "browsers") else []
                for bid, name in browsers:
                    button("Войти через %s" % name, "add", lambda bid=bid: sign.begin(bid))
                # One main action: with a browser to sign in through, the file
                # is the other way.
                button("Войти по QR-коду" if src.login == "code" else "Проверить файл",
                       "drop wide" if browsers else "add", sign.begin)
        if note:
            card.pack_start(label(note, "csub", wrap=True), False, False, 0)
        if buttons.get_children():
            card.pack_start(buttons, False, False, 0)
        return card

