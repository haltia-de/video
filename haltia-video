    def home_settings(self):
        """Which sections Главная shows, and their order: ↑ and ↓ on each
        row, as Настройки of the shell orders the panel; a step is saved
        at once."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sections = self.home_sections()
        for n, (sid, title, on) in enumerate(sections):
            row = Gtk.Box(spacing=12)
            row.get_style_context().add_class("chan")
            name = label(title, "ttl")
            name.set_ellipsize(3)  # Pango.EllipsizeMode.END
            row.pack_start(name, True, True, 0)
            for text, step, can in (("↑", -1, n > 0), ("↓", 1, n < len(sections) - 1)):
                btn = Gtk.Button(label=text, sensitive=can)
                btn.set_tooltip_text("Выше" if step < 0 else "Ниже")
                btn.get_style_context().add_class("step")
                btn.connect("clicked", lambda _b, k=sid, d=step: self.home_step(k, d))
                row.pack_start(btn, False, False, 0)
            switch = Gtk.Switch(active=on)
            switch.set_valign(Gtk.Align.CENTER)
            switch.connect("notify::active", lambda sw, _p, k=sid: self.home_turn(k, sw.get_active()))
            row.pack_start(switch, False, False, 0)
            box.pack_start(row, False, False, 0)
        return box

    def home_step(self, sid, step):
        sections = [(k, on) for k, _t, on in self.home_sections()]
        n = [k for k, _on in sections].index(sid)
        if 0 <= n + step < len(sections):
            sections[n], sections[n + step] = sections[n + step], sections[n]
            self.core.command("home_sections", {"sections": [{"id": k, "on": on} for k, on in sections]})
            self.redraw_after_settings()

    def redraw_after_settings(self):
        def later():
            if self.on_sub("settings"):
                self.show_settings()
            return False
        GLib.idle_add(later)

    def home_turn(self, sid, on):
        sections = [(k, on if k == sid else was) for k, _t, was in self.home_sections()]
        self.core.command("home_sections", {"sections": [{"id": k, "on": v} for k, v in sections]})

