    def bookmark_button(self, kind, obj):
        btn = Gtk.Button()
        btn.get_style_context().add_class("more")
        btn.set_valign(Gtk.Align.CENTER)

        def update():
            saved = self.library.bookmarks.find(kind, obj)
            btn.set_label("★" if saved else "☆")
            btn.set_tooltip_text("Действия с закладкой" if saved else "В закладки")

        def clicked(_btn):
            saved = self.library.bookmarks.find(kind, obj)
            if saved:
                self.bookmark_menu(btn, saved)
            else:
                self.core.command("bookmark_add", {"kind": kind, "entity": obj})
