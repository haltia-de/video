def qr_pixbuf(text):
    """A QR code of text as a picture, or None without the qrcode module."""
    try:
        import qrcode
    except ImportError:
        return None
    qr = qrcode.QRCode(border=2)
    qr.add_data(text)
    qr.make(fit=True)
    matrix = qr.get_matrix()
    n = len(matrix)
    scale = max(1, QR_SIZE // n)
    side = n * scale
    rows = []
    for line in matrix:
        row_bytes = bytearray()
        for dark in line:
            row_bytes += (b"\x00\x00\x00" if dark else b"\xff\xff\xff") * scale
        rows.append(bytes(row_bytes) * scale)
    data = GLib.Bytes.new(b"".join(rows))
    return GdkPixbuf.Pixbuf.new_from_bytes(data, GdkPixbuf.Colorspace.RGB, False, 8,
                                           side, side, side * 3)


class Picture(Gtk.DrawingArea):
    """A card's picture with the strip of how much was watched along its
    bottom, dimmed once done: one widget drawn here, where an image, a box
    and a progress bar were three for GTK to style and measure on every
    card. A new picture only draws it again (an image laid the page out)."""

    STRIP = 6

    def __init__(self, size):
        super().__init__()
        self.set_size_request(*size)
        self.surface = None
        self.screen = None  # the surface where the screen keeps it (X11), made at its first draw
        self.fraction = None
        self.dim = False
        self.connect("draw", self._draw)

    def set_from_surface(self, surface):
        self.surface = surface
        self.screen = None
        self.queue_draw()

    def _on_screen(self):
        """X11 keeps what windows draw on the server: a picture in the
        program's memory went there at every frame (9 cards on screen, some
        7 MB a frame), so it goes once. On Wayland, where windows draw in
        the program's memory, it is drawn as it is."""
        if self.screen is None:
            w, h = self.surface.get_width(), self.surface.get_height()
            similar = self.get_window().create_similar_surface(cairo.CONTENT_COLOR, w, h)
            if isinstance(similar, cairo.ImageSurface):
                self.screen = self.surface
            else:
                cr = cairo.Context(similar)
                cr.set_source_surface(self.surface, 0, 0)
                cr.paint()
                self.screen = similar
        return self.screen

    def set_progress(self, fraction):
        if fraction != self.fraction:
            self.fraction = fraction
            self.queue_draw()

    def set_dim(self, dim):
        if dim != self.dim:
            self.dim = dim
            self.queue_draw()

    def _draw(self, _widget, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        pw, ph = (self.surface.get_width(), self.surface.get_height()) if self.surface else (w, h)
        x, y = (w - pw) // 2, (h - ph) // 2
        if not self.surface:
            # A place for the picture while it comes, not an empty card.
            cr.set_source_rgb(0xde / 255, 0xdd / 255, 0xda / 255)
            cr.rectangle(x, y, pw, ph)
            cr.fill()
        else:
            cr.set_source_surface(self._on_screen(), x, y)
            if self.dim:
                cr.paint_with_alpha(0.4)
            else:
                cr.paint()
        if self.fraction:
            cr.set_source_rgb(0xc0 / 255, 0xbf / 255, 0xbc / 255)
            cr.rectangle(x, y + ph - self.STRIP, pw, self.STRIP)
            cr.fill()
            cr.set_source_rgb(0x35 / 255, 0x84 / 255, 0xe4 / 255)
            cr.rectangle(x, y + ph - self.STRIP, round(pw * self.fraction), self.STRIP)
            cr.fill()
        return False


class Thumbs:
    """Card pictures: fetched and decoded by a few workers (decoding a JPEG
    on the GTK side stalls the page here), kept on disk, and the decoded
    ones kept in memory too, so a page shown again needs no work at all.
    What is still queued for cards gone with their page is dropped."""

    def __init__(self):
        self.kept = pictures.Recent(PIXBUFS_BYTES)  # (url, size): cairo surface
        # Asked for, in turn: a list asks for those nearest the window first.
        self.queue = collections.deque()
        self.ready = threading.Condition()
        self.workers = 0
        self.waiting = {}  # (url, size): [(image, alive)] while it is fetched
        self.lock = threading.Lock()
        os.makedirs(CACHE, exist_ok=True)

    def get(self, url, image, size=(THUMB_W, THUMB_H)):
        if not url:
            return
        key = (url, size)
        image._thumb = key  # what it is to show: drop() or another get() changes it
        alive = getattr(image, "_alive", None)
        if alive is None:
            alive = image._alive = [True]  # read by the workers: no GTK call off its thread
            image.connect("destroy", lambda *_a: alive.__setitem__(0, False))
        with self.lock:
            pix = self.kept.get(key)
            if pix is None:
                if key in self.waiting:
                    # Already on its way (a page drawn again): one fetch for all.
                    self.waiting[key].append((image, alive))
                    return
                self.waiting[key] = [(image, alive)]
        if pix is not None:
            image.set_from_surface(pix)
            return
        with self.ready:
            self.queue.append(key)
            self.ready.notify()
            if self.workers < NET_WORKERS:
                self.workers += 1
                threading.Thread(target=self._work, daemon=True).start()

    def _work(self):
        while True:
            with self.ready:
                while not self.queue:
                    self.ready.wait()
                key = self.queue.popleft()
            self._load(key)

    @staticmethod
    def drop(image):
        """Its picture let go (far from the window, or on a page hidden);
        get() takes it back, from memory if it is still there."""
        image._thumb = None
        image.set_from_surface(None)

    def _load(self, key):
        with self.lock:
            if not any(alive[0] and image._thumb == key for image, alive in self.waiting[key]):
                del self.waiting[key]  # its page is gone
                return
        url, size = key
        path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest() + ".jpg")
        pix = None
        try:
            if not os.path.exists(path):
                data = net.request(url, limit=1024 * 1024)
                with open(path + ".new", "wb") as fh:
                    fh.write(data)
                os.replace(path + ".new", path)
            # Not through gdk-pixbuf's loaders (pictures.py: one stuck
            # loader froze the whole program on the tablet).
            pix = pictures.surface(path, size)
        except (OSError, GLib.Error):
            pass
        with self.lock:
            images = self.waiting.pop(key)
            if pix is not None and not isinstance(pix, GdkPixbuf.Pixbuf):
                self.kept.put(key, pix)
        if pix is not None:
            GLib.idle_add(self._show, images, key, pix)

    def _show(self, images, key, pix):
        if isinstance(pix, GdkPixbuf.Pixbuf):  # without Pillow: made a surface here, on the GTK thread
            pix = Gdk.cairo_surface_create_from_pixbuf(pix, 1, None)
            with self.lock:
                self.kept.put(key, pix)
        for image, alive in images:
            if alive[0] and image._thumb == key:
                image.set_from_surface(pix)
        return False

    @staticmethod
    def prune():
        """Pictures not looked at for a month go, and the oldest while
        there are more than the cache may hold."""
        try:
            files = []
            for entry in os.scandir(CACHE):
                if entry.name.endswith(".jpg") and entry.is_file():
                    st = entry.stat()
                    files.append((st.st_mtime, st.st_size, entry.path))
            files.sort()
            total = sum(f[1] for f in files)
            now = time.time()
            for mtime, size, path in files:
                if total <= CACHE_MAX_BYTES and now - mtime < CACHE_MAX_AGE:
                    break
                os.remove(path)
                total -= size
        except OSError:
            pass


class Video(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.runtime = Runtime(
            post=lambda fn: GLib.idle_add(lambda: (fn(), False)[1]),
            later=lambda ms, fn: GLib.timeout_add(ms, lambda: (fn(), False)[1]))
        self.pool = self.runtime.executor
        self.core = Application(sources.load(), Library(), self.runtime,
                                feed_path=FEED_CACHE, home_path=HOME_CACHE,
                                cache_load=sources.load_json, cache_save=sources.save_json)
        self.sources = self.core.sources
        self.library = self.core.library
        self.thumbs = Thumbs()
        self.signins = self.core.signin_clients("gtk")
        self.signed_in = self.core.signed_in
        self.bookmark_sync = self.core.bookmark_sync
        self._bind_core_collections()
        self.player = Player(post=lambda fn, *a: GLib.idle_add(lambda: (fn(*a), False)[1]))
        self.player.watch(self.show_bar)
        # note_played first: Library.note_position keeps only a video it knows.
        self.player.watch(self.note_played)
        self.player.watch(self.note_position)
        self.recorded_video = None
        self.play_last = None  # the player's state as last seen
        self.play_saved = 0  # when its position was last written down
        self.seeking = False  # a finger on the bar's slider
        self.account_notes = self.core.account_notes
        self.page = "home"
        self.sub = None  # a page over the tabs: search, a channel, settings
        self.keep_counts = None  # while a page is drawn again: how far its lists were made
        self.stars = set()  # the bookmark buttons on show
        self.refreshing = False  # followed channels' details being fetched
        self.refresh_tried = set()
        self.win = None
        self.bookmark_query = ""
        self.bookmark_filters = {"kind": "all", "source": "all", "state": "all",
                                 "sort": "added", "reverse": True}
        self.bookmark_link_busy = False
        self.bookmark_note = ""
        self.web = (Server(self.core, os.path.dirname(self.library.config_path), self._web_changed)
                    if platform.machine().lower() not in ("armv7l", "armv7", "armv6l") else None)
        self.web_redraw_pending = False
        self.web_qr = None
        self.core.watch(self._core_event)
        self.searching = False  # the search holds the row on top
        self.web_open = False  # «Для разработчика» unfolded in Настройки
        self.hints_open = set()  # sources whose «Как войти» is unfolded
        self.back_action = Gio.SimpleAction.new("back", None)
        self.back_action.set_enabled(False)
        self.back_action.connect("activate", self.go_back)
        self.add_action(self.back_action)

    # --- sources ----------------------------------------------------------
    def _bind_core_collections(self):
        for name in ("feed", "home", "searches", "channel_wanted", "playlist_wanted",
                     "channel_videos", "playlists", "playlist_pages", "playlist_all"):
            setattr(self, name, getattr(self.core, name))
        self.channel_epoch = self.core.epoch
        self.playlist_order = {}
        self.pending_playlist_play = None
        self.pending_playlist_resume = None

    def _core_event(self, event):
        kind, data = event["type"], event["data"]
        self.stale_by(kind, data)
        if kind == "library":
            self.library_changed(data["what"])
        elif kind == "cache":
            handlers = {"feed": self._feed_came, "search": self._search_came,
                        "channel_videos": self._channel_came, "playlists": self._channel_came,
                        "playlist_pages": self._playlist_came, "playlist_all": self._playlist_all_came}
            if data["kind"] == "home":
                self.redraw("home")
            else:
                handlers[data["kind"]](data["key"], data.get("failed", False))
        elif kind == "account":
            self._signin_changed(self.sources[data["source"]], data["state"])
        elif kind == "account_note" and self.on_sub("settings"):
            self.show_settings()
        elif kind == "bookmark_sync":
            self.bookmark_sync_changed()
        elif kind == "playback_stopped" and data["id"] == self.core.local_session:
            self.stop_playback()
        elif kind == "queue_changed" and data["id"] == self.core.local_session:
            self.player.reorder_queue(self.core.sessions.get(data["id"])["queue"])

    def stale_by(self, kind, data):
        """Which kept hidden pages a change makes stale (made anew when
        shown): what changes a card in place (lists of every page follow
        it) none; the Library or an account all; the caches the channel
        kept when it is its videos. The tabs' caches redraw() them."""
        if kind == "library" and data["what"] not in ("position", "tasks", "details"):
            self.stale_hidden()
        elif kind == "account":
            self.stale_hidden()
        elif kind == "cache" and data["kind"] in ("channel_videos", "playlists"):
            self.stale_hidden(lambda pane: pane.sub is not None and pane.sub.get("key") == tuple(data["key"]))

    def ordered(self):
        return self.core.ordered()

    def enabled(self):
        return self.core.enabled()

    def is_enabled(self, source_id):
        return self.core.is_enabled(source_id)

    def wanted(self, videos):
        return self.core.wanted(videos)

    def scope(self):
        """The sources a search goes to."""
        on = self.enabled()
        one = [s for s in on if s.id == self.library.scope]
        return one or on

    def scope_label(self):
        scope = self.scope()
        return scope[0].label if len(scope) == 1 and len(self.enabled()) > 1 else "Все сервисы"

    def next_scope(self):
        choices = ["all"] + [s.id for s in self.enabled()]
        now = self.library.scope if self.library.scope in choices else "all"
        self.core.command("scope", {"source": choices[(choices.index(now) + 1) % len(choices)]})
        # A search on show is redone where it now goes.
        if self.sub and self.sub["kind"] == "search":
            self.search(self.sub["query"])
        elif self.sub and self.sub["kind"] == "channels":
            self.find_channels(self.sub["query"])

    def update_scope(self):
        self.scope_btn.set_label(self.scope_label())
        self.scope_btn.set_visible(len(self.enabled()) > 1 and not self.on_page("bookmarks"))

    def do_shutdown(self):
        if self.web:
            self.web.stop()
        self.stop_playback()
        self.core.close()
        self.runtime.close()
        Gtk.Application.do_shutdown(self)

