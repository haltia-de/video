def pixbufs_bytes():
    """Decoded pictures kept in memory: a twentieth of the memory, 16 to
    128 MB (a 600 px one is some 0.5 MB: 32 MB held fewer than История's
    hundred, decoded anew at each visit); on the B8000 (1 GB) 16 MB, some
    eighty of its 352 px ones. The rest are decoded again from the disk
    cache, off the GTK thread."""
    if not sources.LARGE_PICTURES:
        return 16 * 1024 * 1024
    try:
        memory = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
    except (ValueError, OSError):
        memory = 0
    return max(16 * 1024 * 1024, min(memory // 20, 128 * 1024 * 1024))


