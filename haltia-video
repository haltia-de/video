    def bookmark_menu(self, button, saved):
        pop = Gtk.Popover.new(button)
        pop.connect("closed", lambda p: p.destroy())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12)
        ident = saved["key"]

        def action(title, fn, sensitive=True):
            btn = Gtk.Button(label=title, sensitive=sensitive)
            btn.get_style_context().add_class("more")
            btn.connect("clicked", lambda _b: (pop.popdown(), fn()))
            box.pack_start(btn, False, False, 0)

        def remove(local_only=False):
            if saved["links"] and not dialogs.ask(
                    self.win,
                    "Закладка будет удалена из связанных аккаунтов сервиса" +
                    (", но останется на устройстве." if local_only else " и из приложения."),
                    "Оставить только на устройстве" if local_only else "Удалить закладку"):
                return
            self.core.command("bookmark_remove", {"key": ident, "local_only": local_only})
            self.bookmark_sync.refresh()
            if button.get_parent():
                button.set_label("★" if local_only else "☆")

        status = self.bookmark_status(saved)[1]
        box.pack_start(label(status, "hint", wrap=True), False, False, 0)
        pinned = "pin" in saved
        action("Открепить" if pinned else "Закрепить",
               lambda: self.core.command("bookmark_pin", {"key": ident, "on": not pinned}))
        if pinned:
            action("Переместить выше", lambda: self.core.command("bookmark_move", {"key": ident, "step": -1}))
            action("Переместить ниже", lambda: self.core.command("bookmark_move", {"key": ident, "step": 1}))
        link = self.bookmark_sync.link_for(saved["kind"], saved["object"])
        if link and link[0] not in saved["links"]:
            action("Синхронизировать с VK", lambda: (
                self.core.command("bookmark_link", {"key": ident}), self.bookmark_sync.refresh()))
        if saved["links"]:
            action("Оставить только на устройстве", lambda: remove(True))
        action("Удалить закладку", remove)
        pop.add(box)
        pop.show_all()
        pop.popup()
        return pop

    def bookmark_status(self, saved):
        links = saved["links"]
        if not links:
            return "", "Только на этом устройстве"
        notes = []
        for aid, link in links.items():
            name = link.get("account") or aid
            state = link["state"]
            if state == "error":
                note = link.get("error") or "Ошибка синхронизации"
            elif state == "pending":
                note = "Ожидает отправки"
            else:
                note = "Синхронизировано"
            active = any(s["aid"] == aid and self.library.bookmarks.enabled(aid)
                         for s in self.bookmark_sync.sessions.values())
            notes.append("%s · %s%s" % (name, note, "" if active else " · синхронизация выключена"))
        states = [v["state"] for v in links.values()]
        return ("☁ !" if "error" in states else "☁ ↻" if "pending" in states else "☁ ✓"), "\n".join(notes)

