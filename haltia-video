    # --- pages ------------------------------------------------------------
    def show_page(self, key, again=False):
        """A tab: the kept one as it was left, unless what it shows changed
        (again: made anew)."""
        self.page = key
        left, self.sub = self.sub, None
        self.left(left)
        self.searching = key == "bookmarks" and bool(self.bookmark_query)
        self.update_back()
        self.show_top("search" if self.searching else "tabs")
        self.mark_tab(key)
        self.entry.set_placeholder_text("Поиск в закладках" if key == "bookmarks" else "Найти видео")
        self.entry.set_text(self.bookmark_query if key == "bookmarks" else "")
        self.update_scope()
        kept, made = self.enter_tab(key, again)
        if kept:
            if key == "bookmarks":
                self.scope_btn.hide()  # this tab has its own Source filter
            elif key == "channels":
                self.refresh_channels()
            return

        def make():
            self.say("")
            {"home": self.show_home, "feed": self.show_feed, "channels": self.show_channels,
             "bookmarks": self.show_bookmarks, "history": self.show_history}[key]()
        # Made anew where it was scrolled to.
        self.keep_scroll(make) if made else make()

    def on_page(self, key):
        return self.page == key and self.sub is None

    def redraw(self, key):
        """Show the tab again with what came in, if it is on show; kept
        hidden, it is made anew when shown."""
        if self.on_page(key):
            self.show_page(key, again=True)
        elif key in self.panes:
            self.panes[key].stale = True

    # Главная ------------------------------------------------------------
    def home_sections(self):
