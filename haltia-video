        enabled = self.sub is not None or self.page != "home"
        self.back_action.set_enabled(enabled)
        self.back_btn.set_visible(enabled)

    def left(self, sub):
        """A page over the tabs was left: a code no one sees is not asked about."""
        if self.pending_playlist_play and self.pending_playlist_play["sub"] is sub:
            self.pending_playlist_play = None
        if self.pending_playlist_resume and self.pending_playlist_resume["sub"] is sub:
            self.pending_playlist_resume = None
        if sub and sub["kind"] == "settings":
            for sign in self.signins.values():
                sign.cancel()
        if sub and sub["kind"] == "playlist_editor" and sub.get("token"):
            try:
                self.core.command("playlist_cancel", {"entity": sub["playlist"], "token": sub["token"]})
            except ValueError:
                pass

    def on_sub(self, kind, **match):
        """Whether that page is still the one on show (work done in the
        background checks it before showing what it brings)."""
        return (self.sub is not None and self.sub["kind"] == kind
                and all(self.sub.get(k) is v or self.sub.get(k) == v for k, v in match.items()))

    # --- cards ------------------------------------------------------------
    def grid(self, videos, focus_video=None):
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=3, min_children_per_line=3,
                           row_spacing=16, column_spacing=16)
        flow.set_valign(Gtk.Align.START)
        sub = self.sub

        def add(video):
            card = self.card(video)
            flow.add(card)
            if focus_video and playlist_view.same_entry(video, focus_video):
                card.get_style_context().add_class("located")
                self.reveal_video(card, sub)
            return card

        for video in videos[:CARDS_AT_ONCE]:
            add(video)
        rest = list(videos[CARDS_AT_ONCE:])
        if rest:
            state = {"alive": True}
            flow.connect("destroy", lambda *_a: state.update(alive=False))

            def more():
                if not state["alive"]:
                    return False
                for video in rest[:CARDS_PER_IDLE]:
                    add(video).show_all()
                del rest[:CARDS_PER_IDLE]
                return bool(rest)

            GLib.idle_add(more, priority=GLib.PRIORITY_LOW)
        return flow

    def reveal_video(self, card, sub):
        """Locate only after the lazy card and viewport have allocations.
        Switching pages or replacing this grid cancels the request.
        """
        card.set_can_focus(True)
        adjustment = self.scroll.get_vadjustment()
        state = {"done": False, "queued": False, "handler": None}

        def finish(*_args):
            state["done"] = True
            if state["handler"] is not None:
                adjustment.disconnect(state["handler"])
                state["handler"] = None

        def reveal():
            state["queued"] = False
            if state["done"]:
                return False
            if self.sub is not sub:
                finish()
                return False
            if not card.get_mapped() or card.get_allocated_height() <= 1:
                return False
            coords = card.translate_coordinates(self.body, 0, 0)
            if coords is None or adjustment.get_page_size() <= 1:
                return False
            _x, top = coords
            if adjustment.get_upper() < top + card.get_allocated_height() - 1:
                return False
            card.grab_focus()
            adjustment.set_value(max(adjustment.get_lower(), min(
                top, adjustment.get_upper() - adjustment.get_page_size())))
            finish()
            return False

        def queue(*_args):
            if not state["done"] and not state["queued"]:
                state["queued"] = True
                GLib.idle_add(reveal, priority=GLib.PRIORITY_LOW)

        card.connect("map", queue)
        card.connect("size-allocate", queue)
        card.connect("destroy", finish)
        state["handler"] = adjustment.connect("changed", queue)
        queue()

    def card(self, video):
        ev = Gtk.EventBox()
        ev.get_style_context().add_class("card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        image = Gtk.Image()
        image.set_size_request(THUMB_W, THUMB_H)
        picture = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        picture.pack_start(image, False, False, 0)
        seen = self.library.progress(video)
        if seen:
            # How much of it was watched, along the bottom of the picture.
            strip = Gtk.ProgressBar(fraction=seen)
            strip.set_size_request(THUMB_W, -1)
            strip.set_halign(Gtk.Align.CENTER)
            picture.pack_start(strip, False, False, 0)
        box.pack_start(picture, False, False, 0)
        title = label(video["title"], "ttl", wrap=True)
        title.set_lines(2)
        title.set_ellipsize(3)  # Pango.EllipsizeMode.END
        title.set_max_width_chars(28)
        title.set_margin_start(12)
        title.set_margin_end(12)
        box.pack_start(title, False, False, 0)
        bits = [video.get("channel") or "", nice_duration(video.get("duration")),
                nice_age(video.get("published"))]
        sub = label(" · ".join(b for b in bits if b), "sub")
        sub.set_ellipsize(3)
        sub.set_margin_start(12)
        sub.set_margin_end(12)
        box.pack_start(sub, False, False, 0)
        ev.add(box)
        self.thumbs.get(video["thumb"], image)

        # A tap plays; a long press follows or unfollows the channel.
        tap = Gtk.GestureMultiPress(widget=ev)
        hold = Gtk.GestureLongPress(widget=ev)
        hold.set_property("delay-factor", 1.2)
        ev._gestures = (tap, hold)  # keep them alive with the widget
        state = {"held": False}

        def pressed(*_a):
            # Lit like a button: an event box is not by itself.
            state["held"] = False
            ev.set_state_flags(Gtk.StateFlags.ACTIVE, False)

        tap.connect("pressed", pressed)
        tap.connect("released", lambda *_a: None if state["held"] else self.play(video))
        # Ends also when a scroll takes the finger over.
        tap.connect("end", lambda *_a: ev.unset_state_flags(Gtk.StateFlags.ACTIVE))
        hold.connect("pressed", lambda *_a: (state.update(held=True),
                                             ev.unset_state_flags(Gtk.StateFlags.ACTIVE),
                                             self.follow_menu(video)))
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        outer._video_key = (video["source"], video["id"])
        outer._entry_id = video.get("entry_id")
        outer.pack_start(ev, True, True, 0)
        outer.pack_start(self.bookmark_button("video", video), False, False, 0)
        if self.on_sub("playlist") and self.sub["order"] == "lesson":
            task = Gtk.CheckButton(label="Выполнено")
            task.set_active(bool(video.get("task_done")))
            playlist = self.sub["playlist"]
            def toggle(check):
                try:
                    self.core.command("playlist_task", {"entity": playlist, "video": video,
                                                         "on": check.get_active()})
                except ValueError as exc:
                    self.say(str(exc))
            task.connect("toggled", toggle)
            outer.pack_start(task, False, False, 0)
        return outer

