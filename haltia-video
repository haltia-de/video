    def show_web(self, again=False):
        """Доступ из браузера: the server, connecting a device, the devices
        connected, and (folded) the port and a proxy, which a running
        server takes on by restarting itself."""
        if not again:
            self.open_sub({"kind": "web"}, "Доступ из браузера")
        self.say("")
        state = self.web.snapshot()
        on = state["state"] == "on"
        urls = sorted(state["urls"], key=lambda url: "127.0.0.1" in url)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        def card():
            c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            c.get_style_context().add_class("chan")
            box.pack_start(c, False, False, 0)
            return c

        self.section(box, "Сервер")
        c = card()
        row = Gtk.Box(spacing=12)
        row.pack_start(label("Доступ из браузера", "cname"), True, True, 0)
        switch = Gtk.Switch(active=state["enabled"])
        switch.set_valign(Gtk.Align.CENTER)
        switch.connect("notify::active", lambda sw, _p: self.web_enable(sw.get_active()))
        row.pack_start(switch, False, False, 0)
        c.pack_start(row, False, False, 0)
        if on:
            c.pack_start(label("Работает. Адрес для браузера:", "csub"), False, False, 0)
            for url in urls:
                address = label(url, "cname")
                address.set_selectable(True)
                c.pack_start(address, False, False, 0)
        else:
            c.pack_start(label(state["note"] if state["state"] in ("starting", "stopping", "failed") and state["note"]
                               else "Выключен. Включите, чтобы смотреть Видео в браузере планшета или "
                                    "телефона в этой же сети.", "csub", wrap=True), False, False, 0)
        c.pack_start(label("Сервер работает, пока открыто приложение на этом компьютере. "
                           "Трафик в локальной сети не шифруется.", "cdesc", wrap=True), False, False, 0)

        if on:
            self.section(box, "Подключить устройство")
            c = card()
            pending = self.web.pairing.pending
            if pending and pending["until"] > time.time():
                steps = Gtk.Box(spacing=24)
