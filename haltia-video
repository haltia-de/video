    def bookmark_filter(self, field, value, combo=None):
        if value is not None:
            self.bookmark_filters[field] = value
            if combo:
                self.redraw_after(combo, self.show_bookmarks)
            else:
                self.show_bookmarks()

    def redraw_after(self, combo, redraw):
        """Redraw the page once a combo box's "changed" has returned. GTK
        notifies "active" on the box after the handler, and a page rebuilt
        inside it had already freed the box: a crash on the P11 whenever the
        freed memory was reused. A page left meanwhile is not redrawn."""
        def later():
            if combo.get_parent():
                redraw()
            return False
        GLib.idle_add(later)

