    def show_channel(self, chan, again=False):
        key = (chan["source"], chan["id"])
        if not again:
            if self.restore_channel(chan):
                return
            self.open_sub({"kind": "channel", "chan": chan, "key": key}, chan["title"])
        if chan["source"] not in self.sources:
            return
        self.channel_wanted[key] = chan
        videos = self.channel_videos.get(key)
        if videos is not None:
            videos = self.wanted(videos)
        if videos is None:
            self.say(self.core.views.failure(chan["source"], self.channel_videos, key, "channel")
                     if self.channel_videos.has_failed(key)
                     else "Загружаю…")
        else:
            self.say("" if videos else "У канала пока нет видео.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.channel_header(chan), False, False, 0)
        src = self.sources[chan["source"]]
        sub = self.sub
        if hasattr(src, "playlists") and hasattr(src, "playlist_videos"):
            # Videos first: a channel's dozen playlists used to push them
            # off the screen.
            playlists = self.playlists.get(key)
            tab = sub.get("tab", "videos")
            switch = Gtk.Box(spacing=0)
            switch.get_style_context().add_class("seg")
            switch.set_halign(Gtk.Align.START)
            for kind, title in (("videos", "Видео"),
                                ("playlists", "Плейлисты" + (" · %d" % len(playlists) if playlists else ""))):
                btn = Gtk.Button(label=title)
                btn.get_style_context().add_class("tab")
                if kind == tab:
                    btn.get_style_context().add_class("current")
                btn.connect("clicked", lambda _b, k=kind: (sub.update(tab=k), self.show_channel(chan, again=True))
                            if self.sub is sub and k != sub.get("tab", "videos") else None)
                switch.pack_start(btn, False, False, 0)
            box.pack_start(switch, False, False, 0)
            if tab == "playlists":
                self.say("")
                if playlists:
                    box.pack_start(self.lazy(playlists, lambda p: self.playlist_card(p, chan),
                                             self.columns()).widget, False, False, 0)
                else:
                    box.pack_start(label("Не удалось загрузить плейлисты." if self.playlists.has_failed(key)
                                         else "Загружаю плейлисты…" if playlists is None
                                         else "У канала нет плейлистов.", "hint", wrap=True), False, False, 0)
                self.set_content(box)
                return
        box.pack_start(self.grid(videos or [], hide_channel=True), False, False, 0)
        self.set_content(box)

