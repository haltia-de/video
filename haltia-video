            btn.get_style_context().add_class("add")
            btn.connect("clicked", lambda _b: (self.core.command("follow", {"entity": chan}), self.redraw_sub(sub)))
        return btn

    def redraw_sub(self, sub):
        if self.sub is sub:
            self.keep_scroll(lambda: self.show_results(sub))

