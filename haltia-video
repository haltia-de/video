    def open_bookmark(self, saved):
        obj, kind = saved["object"], saved["kind"]
        if obj["source"] not in self.sources:
            self.say("Этот сервис сейчас недоступен. Закладка сохранена.")
        elif kind == "video":
            self.play(obj)
        elif kind == "channel":
            self.show_channel(obj)
        else:
            # Back leads to Закладки: a YouTube playlist may name no channel.
            chan = {"source": obj["source"], "id": obj.get("owner_id", ""),
                    "title": obj.get("owner_title") or "Канал плейлиста", "from_bookmarks": True}
            self.show_playlist(obj, chan)

    def show_bookmarks(self):
        self.scope_btn.hide()  # this tab has its own Source filter
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        # One row: the kinds as chips, a chip for any other filter on (a
        # tap clears it), and ⋮ for the rest. Two rows of drop-downs stood
        # over even a single bookmark.
        f = self.bookmark_filters
        row = Gtk.Box(spacing=12)
        for value, title in [("all", "Все")] + list(bookmark_view.KINDS):
            chip = Gtk.Button(label=title)
            chip.get_style_context().add_class("chip")
            if f["kind"] == value:
                chip.get_style_context().add_class("on")
            chip.connect("clicked", lambda _b, v=value: self.bookmark_filter("kind", v))
            row.pack_start(chip, False, False, 0)
        names = dict([(s.id, s.label) for s in self.ordered()] +
