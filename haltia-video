    def warm_up(self):
        for src in self.enabled():
            try:
                getattr(src, "warm_up", lambda: None)()
            except Exception:
                pass

    def say(self, text):
        """The line over a page's content. A spinner turns beside one that
        tells of something on its way («Загружаю…», «Ищу…»): a page that
        only waits looked stuck."""
        pane = self.pane
        if text:
            pane.note_text.set_text(text)
            pane.note.show()
            if text.endswith("…"):
                pane.spinner.show()
                pane.spinner.start()
                return
        else:
            pane.note.hide()
        pane.spinner.stop()  # a turning one asks for every frame
        pane.spinner.hide()

    # --- panes ------------------------------------------------------------
    def make_pane(self, title=None):
        """A page's own scrolled window, with its note over its content."""
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_kinetic_scrolling(True)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        # The note and the cards scroll together: a wrapped label outside
        # the scrolled part made the window taller than the room the
        # on-screen keyboard leaves, and the window covered its top row.
        note = Gtk.Box(spacing=16)
        note.set_no_show_all(True)
        note.set_margin_top(12)
        spinner = Gtk.Spinner()
        spinner.set_size_request(32, 32)
        spinner.set_no_show_all(True)
        note.pack_start(spinner, False, False, 0)
        text = label("", "note", wrap=True)
        text.show()
        note.pack_start(text, True, True, 0)
        body.pack_start(note, False, False, 0)
        scroll.add(body)
        scroll.show_all()
        self.stack.add(scroll)
        return SimpleNamespace(scroll=scroll, body=body, note=note, note_text=text, spinner=spinner,
                               made=time.monotonic(), stale=False, sub=None, title=title)

    def use_pane(self, pane):
        self.pane = pane
        self.scroll, self.body, self.note = pane.scroll, pane.body, pane.note
        self.stack.set_visible_child(pane.scroll)

    def drop_pane(self, pane):
        if pane is not None and pane is not self.pane:
            pane.scroll.destroy()

    def fresh(self, pane):
        return (pane is not None and not pane.stale
                and time.monotonic() - pane.made < KEEP_PAGE_SEC)

    def hidden_panes(self):
        return [p for p in list(self.panes.values()) + [self.sub_pane, self.prev_pane]
                if p is not None and p is not self.pane]

    def stale_hidden(self, match=lambda pane: True):
        """Kept pages the change is shown on are made anew when shown."""
        for pane in self.hidden_panes():
            if match(pane):
                pane.stale = True

    def enter_tab(self, key, again):
        """The tab's pane on show, the sub-pages' gone; whether it is kept
        as it was (else it is to be made), and whether it was made before."""
        pane = self.panes.get(key)
        kept, made = self.fresh(pane) and not again, pane is not None
        if pane is None:
            pane = self.panes[key] = self.make_pane()
        self.use_pane(pane)
        for old in (self.sub_pane, self.prev_pane):
            self.drop_pane(old)
        self.sub_pane = self.prev_pane = None
        if not KEEP_PAGES:
            for k in [k for k in self.panes if k not in (key, "home")]:
                self.drop_pane(self.panes.pop(k))
        if not kept:
            pane.made, pane.stale = time.monotonic(), False
        return kept, made

    def enter_sub(self, left, title):
        """A new pane for a sub-page; the channel it is opened from kept."""
        old, gone = self.sub_pane, [self.prev_pane]
        self.prev_pane = None
        if left is not None and left["kind"] == "channel" and KEEP_PAGES and old is not None:
            self.prev_pane, old.sub = old, left
        else:
            gone.append(old)
        self.sub_pane = self.make_pane(title)
        self.use_pane(self.sub_pane)
        for pane in gone:
            self.drop_pane(pane)

    def tab_clicked(self, key):
        """A tab; the one on show again goes back to its top."""
        if self.on_page(key) and not self.searching:
            self.scroll.get_vadjustment().set_value(0)
        else:
            self.show_page(key)

    def set_content(self, widget):
        for child in self.body.get_children():
            if child is not self.note:
                self.body.remove(child)
                child.destroy()
        self.body.pack_start(widget, False, False, 0)
        self.scroll.get_vadjustment().set_value(0)
        widget.show_all()

    def mark_tab(self, key):
        for k, btn in self.tabs.items():
            ctx = btn.get_style_context()
            (ctx.add_class if k == key else ctx.remove_class)("current")

    def open_sub(self, sub, title):
        """A page over the tabs; the back button returns to the tab. The
        channel it is opened from is kept (restore_channel)."""
        left, self.sub = self.sub, sub
        self.enter_sub(left, title)
        self.searching = sub["kind"] == "search"
        self.show_top("search" if self.searching else "title", title)
        self.entry.set_placeholder_text("Найти видео")
        self.update_scope()
        self.update_back()
        self.left(left)

    def restore_channel(self, chan):
        """Back on the channel a playlist was opened from: as it was left,
        if nothing it shows has changed."""
        prev = self.prev_pane
        if not (self.fresh(prev) and prev.sub["kind"] == "channel"
                and prev.sub["key"] == (chan["source"], chan["id"])):
            return False
        left, self.sub = self.sub, prev.sub
        old, self.sub_pane, self.prev_pane = self.sub_pane, prev, None
        self.use_pane(prev)
        self.drop_pane(old)
        self.searching = False
        self.show_top("title", prev.title)
        self.update_scope()
        self.update_back()
        self.left(left)
        return True

    def show_top(self, mode, title="Видео"):
        """What the one row on top shows: the tabs, a page's title or the search."""
        self.top.set_visible_child_name(mode)
        self.title.set_text(title)
        self.find_btn.set_visible(mode != "search")

    def open_search(self):
        """The search takes the row; it is opened by a tap, so the keyboard may come."""
        self.searching = True
        self.entry.set_placeholder_text("Поиск в закладках" if self.on_page("bookmarks") else "Найти видео")
        self.update_scope()
        self.show_top("search")
        self.update_back()
        self.entry.grab_focus()

    def close_search(self):
        self.searching = False
        self.entry.set_text("")
        self.win.set_focus(None)  # the keyboard goes away
        self.show_top("tabs")
        self.update_back()
        if self.on_page("bookmarks") and self.bookmark_query:
            self.bookmark_query = ""
            self.show_bookmarks()

    def go_back(self, *_args):
        if self.searching and self.sub is None:
            self.close_search()
            return
        if self.sub and self.sub["kind"] == "playlist_editor":
            self.finish_playlist_editor(False)
            return
        if (self.sub and self.sub["kind"] == "playlist" and not self.sub["chan"].get("from_bookmarks")
                and not self.sub["chan"].get("from_tab")):
            self.show_channel(self.sub["chan"])
            return
        self.show_page(self.page if self.sub is not None else "home")

    def update_back(self):
        enabled = self.sub is not None or self.page != "home" or self.searching
        self.back_action.set_enabled(enabled)
        self.back_btn.set_visible(enabled)

    def left(self, sub):
        """A page over the tabs was left: a code no one sees is not asked about."""
        if self.pending_playlist_play and self.pending_playlist_play["sub"] is sub:
            self.pending_playlist_play = None
        if self.pending_playlist_resume and self.pending_playlist_resume["sub"] is sub:
            self.pending_playlist_resume = None
        if sub and sub["kind"] == "settings":
            for sign in self.signins.values():
                sign.cancel()
        if sub and sub["kind"] == "playlist_editor" and sub.get("token"):
            try:
                self.core.command("playlist_cancel", {"entity": sub["playlist"], "token": sub["token"]})
            except ValueError:
                pass

    def on_sub(self, kind, **match):
        """Whether that page is still the one on show (work done in the
        background checks it before showing what it brings)."""
        return (self.sub is not None and self.sub["kind"] == kind
                and all(self.sub.get(k) is v or self.sub.get(k) == v for k, v in match.items()))

    # --- cards ------------------------------------------------------------
    def columns(self):
        """Three cards a row; two when the tablet stands upright, where three
        no longer fit its width."""
        return 2 if self.portrait else 3

    def _resized(self, win, alloc):
        """Upright, two cards a row; and the pictures follow the width: the
        page is drawn again once the size has settled."""
        self.portrait = alloc.height > alloc.width
        size = (self.portrait, self.card_size())
        if size == self.drawn_size:
            return
        self.drawn_size = size
        self.stale_hidden()  # their cards are of the old size
        if self.resize_pending:
            GLib.source_remove(self.resize_pending)
        self.resize_pending = GLib.timeout_add(300, self._redraw_resized)

    def _redraw_resized(self):
        self.resize_pending = None
        if self.sub is None:
            self.redraw(self.page)
        elif self.sub["kind"] in ("playlist", "channel", "search", "source_home", "my_playlists"):
            sub = self.sub
            self.keep_scroll(lambda: {
                "playlist": lambda: self.show_playlist(sub["playlist"], sub["chan"], sub["key"][3],
                                                       again=True, previous=sub["previous"]),
                "channel": lambda: self.show_channel(sub["chan"], again=True),
                "search": lambda: self.show_results(sub),
                "source_home": lambda: self.show_source_home(self.sources[sub["source"]]),
                "my_playlists": self.show_my_playlists}[sub["kind"]]())
        return False

    def keep_scroll(self, redraw):
        """redraw() with the page left where it was scrolled to: its lists
        made again as far as they were, or the place would not be there."""
        value = self.scroll.get_vadjustment().get_value()
        self.keep_counts = [lst.built for lst in sorted(LazyList.live, key=lambda lst: lst.serial)
                            if lst.widget.is_ancestor(self.body)]
        try:
            redraw()
        finally:
            self.keep_counts = None
        self.scroll.get_vadjustment().set_value(value)

    def lazy(self, items, make, cols=None, spacing=12, at_least=0):
        """A list made as it is scrolled to (lazy_list.py); in a page drawn
        again, as far as the one it replaces."""
        if self.keep_counts:
            at_least = max(at_least, self.keep_counts.pop(0))
        return LazyList(items, make, cols, spacing, at_least)

    def grid(self, videos, focus_video=None, hide_channel=False):
        size = self.card_size()
        cards = self.lazy(videos, lambda video: self.card(video, size, hide_channel), self.columns())
        if focus_video:
            cards.locate(lambda video: playlist_view.same_entry(video, focus_video),
                         lambda card: card.get_style_context().add_class("located"))
        return cards.widget

    def card_size(self):
        """A card's picture: the card's whole width, so the space beside a
        fixed 352 px one is used (on the B8000 that one stays)."""
        if not sources.LARGE_PICTURES:
            return THUMB_W, THUMB_H
        width = self.scroll.get_allocated_width()
        if width < 400:  # not laid out yet: the window less its border
            width = (self.win.get_allocated_width() if self.win.get_allocated_width() > 400
                     else self.win.get_default_size()[0]) - 32
        cols = self.columns()
        # 24: the scroll bar; 16 between cards; each card some 20 px of its
        # own (the flow box's child padding and borders): a picture of the
        # card's full width pushed the third card past the window's edge.
        w = (width - 24 - 16 * (cols - 1)) // cols - 24
        w = max(THUMB_W, min(w, CARD_PICTURE_MAX))
        return w, w * 9 // 16

    def card(self, video, size=(THUMB_W, THUMB_H), hide_channel=False):
        # Few widgets: GTK's cost of a page is that of its widgets, a dozen
        # a card made a page of them slow on the tablet.
        ev = Gtk.EventBox()
        ev.get_style_context().add_class("card")
        ev._video_key = (video["source"], video["id"])
        ev._entry_id = video.get("entry_id")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        picture = Picture(size)
        # ☆ and ⋮ sit on the picture's corner, and in a playlist by lessons
        # the mark of a lesson done on the other: a strip of its own under
        # every card was a row of noise for each three cards.
        over = Gtk.Overlay(halign=Gtk.Align.CENTER)  # the corner of the picture, not of the card
        over.add(picture)
        corner = Gtk.Box(spacing=8, halign=Gtk.Align.END, valign=Gtk.Align.START, margin=8)
        corner.pack_start(self.bookmark_button("video", video, "pic"), False, False, 0)
        more = Gtk.Button(label="⋮")
        more.get_style_context().add_class("pic")
        more.set_tooltip_text("Действия")
        more.connect("clicked", lambda b: self.card_menu(video, b))
        corner.pack_start(more, False, False, 0)
        over.add_overlay(corner)
        task = None
        if self.on_sub("playlist") and self.sub["order"] == "lesson":
            playlist = self.sub["playlist"]
            task = Gtk.Button(halign=Gtk.Align.START, valign=Gtk.Align.START, margin=8)
            task.get_style_context().add_class("pic")
            task._task = video

            def toggle(_btn):
                try:
                    self.core.command("playlist_task", {"entity": playlist, "video": video,
                                                         "on": not task._done})
                except ValueError as exc:
                    self.say(str(exc))
            task.connect("clicked", toggle)
            over.add_overlay(task)
        box.pack_start(over, False, False, 0)
        # On a channel's page its name, in a playlist its name in each
        # title, are what the page says already.
        title = label(video.get("label") or video["title"], "ttl", wrap=True)
        title.set_lines(2)
        title.set_ellipsize(3)  # Pango.EllipsizeMode.END
        title.set_max_width_chars(28 if size[0] <= THUMB_W else 50)
        title.set_margin_start(12)
        title.set_margin_end(12)
        box.pack_start(title, False, False, 0)
        bits = ["" if hide_channel or video.get("hide_channel") else video.get("channel") or "",
                nice_duration(video.get("duration")), nice_age(video.get("published"))]
        sub = label(" · ".join(b for b in bits if b), "sub")
        sub.set_ellipsize(3)
        sub.set_margin_start(12)
        sub.set_margin_end(12)
        box.pack_start(sub, False, False, 0)
        ev.add(box)

        def refresh():
            # What changes without the page: how much was watched, a lesson done.
            picture.set_progress(self.library.progress(video))
            if task is not None:
                done = bookmark_view.key("video", video) in self.library.task_done(playlist)
                task._done = done
                task.set_label("✓" if done else "○")
                (task.get_style_context().add_class if done else task.get_style_context().remove_class)("done")
                task.set_tooltip_text("Выполнено: снять отметку" if done else "Отметить выполненным")
                picture.set_dim(done)
        refresh()
        ev._refresh = refresh

        # Its list asks for its picture, those nearest the window first.
        ev._pictures = lambda on: (self.thumbs.get(video["thumb"], picture, size) if on
                                   else self.thumbs.drop(picture))

        # A tap plays; a long press opens the same menu as ⋮.
        tap = Gtk.GestureMultiPress(widget=ev)
        hold = Gtk.GestureLongPress(widget=ev)
        hold.set_property("delay-factor", 1.2)
        ev._gestures = (tap, hold)  # keep them alive with the widget
        # ...and let them go while it is still there: a gesture freed with
        # the widget's last handlers disconnected from a finalized widget
        # (GObject criticals on every page change).
        ev.connect("destroy", lambda w: setattr(w, "_gestures", None))
        state = {"held": False}

        def pressed(*_a):
            # Lit like a button: an event box is not by itself.
            state["held"] = False
            ev.set_state_flags(Gtk.StateFlags.ACTIVE, False)

        tap.connect("pressed", pressed)
        tap.connect("released", lambda *_a: None if state["held"] else self.play(video))
        # Ends also when a scroll takes the finger over.
        tap.connect("end", lambda *_a: ev.unset_state_flags(Gtk.StateFlags.ACTIVE))
        hold.connect("pressed", lambda *_a: (state.update(held=True),
                                             ev.unset_state_flags(Gtk.StateFlags.ACTIVE),
                                             GLib.idle_add(lambda: self.card_menu(video, ev) and False)))
        return ev

