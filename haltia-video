    def go_back(self, *_args):
        if self.sub and self.sub["kind"] == "playlist_editor":
            self.finish_playlist_editor(False)
            return
        if self.sub and self.sub["kind"] == "playlist" and not self.sub["chan"].get("from_bookmarks"):
            self.show_channel(self.sub["chan"])
            return
        self.show_page(self.page if self.sub is not None else "home")

