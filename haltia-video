    def bookmark_link_page(self):
        self.open_sub({"kind": "bookmark_link"}, "Добавить закладку")
        self.say("")
        sub = self.sub
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        entry = Gtk.Entry(placeholder_text="Ссылка на видео, плейлист или канал")
        entry.get_style_context().add_class("search")
        # «Вставить»: on the tablet a link comes from the clipboard, and the
        # on-screen keyboard's way to paste is a long press and a menu.
        paste = Gtk.Button(label="Вставить")
        paste.get_style_context().add_class("more")
        paste.connect("clicked", lambda _b: Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).request_text(
            lambda _c, text: text and entry.set_text(text.strip())))
        row = Gtk.Box(spacing=12)
        row.pack_start(entry, True, True, 0)
        row.pack_start(paste, False, False, 0)
        box.pack_start(row, False, False, 0)
        note = label("", "hint", wrap=True)
        add = Gtk.Button(label="Добавить")
        add.get_style_context().add_class("add")

        def submit(*_a):
            if self.bookmark_link_busy or not entry.get_text().strip():
                return
            url = entry.get_text().strip()
            src = next((s for s in self.sources.values() if s.owns(url) and
                        hasattr(s, "resolve_bookmark")), None)
            if not src:
                note.set_text("Нужна ссылка поддерживаемого видеосервиса.")
                return
            self.bookmark_link_busy = True
            epoch = self.channel_epoch
            add.set_sensitive(False)
            note.set_text("Проверяю ссылку…")

            def done(answer, error):
                self.bookmark_link_busy = False
                if self.sub is not sub:
                    return
                add.set_sensitive(True)
                if epoch != self.channel_epoch:
                    note.set_text("Аккаунт изменился. Проверьте ссылку ещё раз.")
                    return
                if error or not answer:
                    note.set_text("Не удалось открыть ссылку. Проверьте доступ к объекту и соединение.")
                    return
                kind, obj = answer
                old = self.library.bookmarks.find(kind, obj)
                if old:
                    self.open_bookmark(old)
                else:
                    self.core.command("bookmark_add", {"kind": kind, "entity": obj})
                    self.bookmark_sync.refresh()
                    self.show_page("bookmarks")
            self.work(src.resolve_bookmark, url, done=done)

        entry.connect("activate", submit)
        add.connect("clicked", submit)
        box.pack_start(add, False, False, 0)
        box.pack_start(note, False, False, 0)
        self.set_content(box)

