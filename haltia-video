    def channel_row(self, chan, action):
        """A channel with what is known about it; a tap opens it, action
        (a button) sits at the end. Details that come later fill it in
        place (_refresh)."""
        row = Gtk.Box(spacing=12)
        row.get_style_context().add_class("chan")
        open_btn = Gtk.Button()
        open_btn.get_style_context().add_class("open")
        shown = {}

        def fill(chan):
            shown.update(chan=chan)
            inner = Gtk.Box(spacing=16)
            avatar = shown["avatar"] = Gtk.Image()
            avatar.get_style_context().add_class("thumb")
            avatar.set_size_request(AVATAR, AVATAR)
            avatar.set_valign(Gtk.Align.START)
            if shown.get("asked"):
                self.thumbs.get(chan.get("thumb"), avatar, (AVATAR, AVATAR))
            inner.pack_start(avatar, False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            text.set_valign(Gtk.Align.CENTER)
            name = label(chan["title"], "cname")
            name.set_ellipsize(3)  # Pango.EllipsizeMode.END
            text.pack_start(name, False, False, 0)
            latest = nice_age(chan.get("latest"))
            src = self.sources.get(chan["source"])
            bits = [src.label if src and len(self.sources) > 1 else "",
                    chan.get("handle") or "", nice_subscribers(chan.get("subscribers")),
                    ("новое видео " + latest) if latest else ""]
            bits = [b for b in bits if b]
            if bits:
                sub = label(" · ".join(bits), "csub")
                sub.set_ellipsize(3)
                text.pack_start(sub, False, False, 0)
            if chan.get("description"):
                desc = label(without_links(chan["description"]), "cdesc", wrap=True)
                desc.set_lines(2)
                desc.set_ellipsize(3)
                desc.set_max_width_chars(60)
                text.pack_start(desc, False, False, 0)
            inner.pack_start(text, True, True, 0)
            open_btn.add(inner)

        def refresh():
            known = next((c for c in self.library.channels()
                          if c["source"] == chan["source"] and c["id"] == chan["id"]), None)
            if known is not None and known != shown["chan"]:
                old = open_btn.get_child()
                open_btn.remove(old)
                old.destroy()
                fill(known)
                open_btn.show_all()

        fill(chan)
        open_btn.connect("clicked", lambda _b: self.show_channel(shown["chan"]))
        row.pack_start(open_btn, True, True, 0)
        action.set_valign(Gtk.Align.CENTER)
        row.pack_start(action, False, False, 0)
        row.pack_start(self.bookmark_button("channel", chan), False, False, 0)
        row._refresh = refresh
        # Its list asks for the avatar: asked while rows are still being made,
        # the workers' decoding took the GTK thread's turns (Pillow holds the
        # interpreter's lock), some 25 ms a row on the tablet instead of 6.
        def pictures(on):
            shown["asked"] = on
            if on:
                self.thumbs.get(shown["chan"].get("thumb"), shown["avatar"], (AVATAR, AVATAR))
            else:
                self.thumbs.drop(shown["avatar"])
        row._pictures = pictures
        return row

