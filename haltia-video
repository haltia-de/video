                controls = Gtk.Box(spacing=12)
                spin = Gtk.SpinButton.new_with_range(item["minimum"] + 1, item["maximum"] + 1, 1)
                spin.set_value(item["position"] + 1)
                for title, target, sensitive in (
                        ("Выше", lambda v=item: v["position"] - 1, item["position"] > item["minimum"]),
                        ("Ниже", lambda v=item: v["position"] + 1, item["position"] < item["maximum"]),
                        ("На позицию…", lambda s=spin: s.get_value_as_int() - 1, True)):
                    btn = Gtk.Button(label=title, sensitive=sensitive)
                    btn.get_style_context().add_class("more")
                    btn.connect("clicked", lambda _b, v=item, dest=target: self.move_playlist_entry(v["entry_id"], dest()))
