    def show_playlist(self, playlist, chan, offset=0, again=False, previous=(), focus_video=None):
        key = (playlist["source"], playlist["owner_id"], playlist["id"], offset)
        order = self.playlist_order.get(key[:3], self.library.playlist_order(playlist))
        if not again:
            self.open_sub({"kind": "playlist", "playlist": playlist, "chan": chan,
                           "key": key, "previous": previous, "order": order,
                           "focus_video": focus_video}, playlist["title"])
        result = self.core.query("playlist", {"entity": playlist, "order": order, "offset": offset})
        self.sub["result"] = result
        page = {"videos": result["items"], "next": result["next"]} if result["ready"] else None
        failed = result["failed"]
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        # Over the cards; drawn again alone when a lesson is marked done.
        self.sub["head"] = head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(head, False, False, 0)
        self.playlist_head(self.sub, result)
        if page is None:
            self.say(result["failure"] if failed else
                     ("Загружаю весь плейлист…" if order != "vk" else "Загружаю…"))
        else:
            videos = self.wanted(page["videos"])
            self.say("" if videos else "На этой странице нет доступных видео.")
            box.pack_start(self.grid(videos, focus_video=self.sub.get("focus_video")), False, False, 0)
        nav = Gtk.Box(spacing=12)
        for title, pos, trail in (
                ("← Предыдущие", previous[-1] if previous else None, previous[:-1]),
                ("Следующие →", page["next"] if page else None, previous + (offset,))):
            if pos is not None:
                btn = Gtk.Button(label=title)
                btn.get_style_context().add_class("more")
                btn.connect("clicked", lambda _b, p=pos, t=trail:
                            self.show_playlist(playlist, chan, p, previous=t))
                nav.pack_start(btn, True, True, 0)
        box.pack_start(nav, False, False, 0)
        self.set_content(box)

    def playlist_head(self, sub, result=None):
        """The row over a playlist's cards (the order, «Продолжить» and ⋮)
        and the line of lessons done; asked again without result."""
        playlist, chan, key, order = sub["playlist"], sub["chan"], sub["key"], sub["order"]
        if result is None:
            result = sub["result"] = self.core.query("playlist", {"entity": playlist, "order": order,
                                                                  "offset": key[3]})
        head = sub["head"]
        for child in head.get_children():
            head.remove(child)
            child.destroy()
        sorting = Gtk.ComboBoxText()
        sorting.get_style_context().add_class("choice")
        sorting.set_tooltip_text("По номеру урока: номер по возрастанию, внутри одного номера — "
                                 "обратный порядок сервиса.")
        for oid, title in playlist_view.ORDERS:
            sorting.append(oid, title)
        sorting.set_active_id(order)

        def changed(combo):
            selected = combo.get_active_id()
            if self.sub is sub and selected is not None and selected != order:
                self.playlist_order[key[:3]] = selected
                self.redraw_after(combo, lambda: self.show_playlist(playlist, chan))

        sorting.connect("changed", changed)
        # One row over the cards: the order, «Продолжить» and ⋮ for the rest.
        # The resets and the editor are rare, so they wait in the menu.
        tools = Gtk.Box(spacing=12)
        tools.pack_start(sorting, False, False, 0)
        resume, note = self.playlist_resume(sub)
        if resume:
            tools.pack_start(resume, True, True, 0)
        else:
            tools.pack_start(Gtk.Box(), True, True, 0)
        more = Gtk.Button(label="⋮")
        more.get_style_context().add_class("more")
        more.set_tooltip_text("Ещё")
        more.connect("clicked", lambda b: self.menu(b, self.playlist_actions(sub)))
        tools.pack_start(more, False, False, 0)
        head.pack_start(tools, False, False, 0)
        bits = []
        if order == "lesson":
            bits.append("Выполнено %d из %d" % (result["tasks"]["done"], result["tasks"]["total"]))
        if note:
            bits.append(note)
        if bits:
            head.pack_start(label(" · ".join(bits), "hint", wrap=True), False, False, 0)
        head.show_all()

    def show_playlist_editor(self, playlist=None, chan=None, order=None, return_order=None, again=False):
        """The whole playlist in the order being made: a tap picks a video, a
        tap on another puts it before that one. Each move is saved at once;
        «Отменить» takes the last back. Dragging was left out: under a finger
        GTK 3 would need it written by hand, and the B8000 would jerk."""
        if not again:
            self.open_sub({"kind": "playlist_editor", "playlist": playlist, "chan": chan,
                           "key": (playlist["source"], str(playlist.get("owner_id", "")), playlist["id"]),
                           "order": order, "return_order": return_order, "pick": None, "undo": []},
                          "Порядок уроков" if order == "lesson" else "Мой порядок")
        sub = self.sub
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        try:
            result = self.core.query("playlist_editor", {"entity": sub["playlist"], "order": sub["order"],
                                     "token": sub.get("token"), "count": 2000})
        except ValueError as exc:
            sub.pop("token", None)
            self.say(str(exc))
            self.set_content(box)
            return
        if result.get("loading") or result.get("failed"):
            self.say(result.get("failure") or "Загружаю плейлист…")
            self.set_content(box)
            return
        sub["token"] = result["token"]
        items = result["items"]
        sub["items"] = items
        picked = next((v for v in items if v["entry_id"] == sub["pick"]), None)
        if picked is None:
            sub["pick"] = None
        tools = Gtk.Box(spacing=12)

        def tool(title, fn, style="more"):
            btn = Gtk.Button(label=title)
            btn.get_style_context().add_class(style)
            btn.connect("clicked", lambda _b: fn())
            tools.pack_start(btn, False, False, 0)

        if picked:
            hint = "Куда поставить «%s»? Нажмите видео, перед которым оно встанет." % picked["title"]
            tool("В начало", lambda: self.editor_place(picked["minimum"]))
            tool("В конец", lambda: self.editor_place(picked["maximum"]))
            tool("Отмена", lambda: self.editor_pick(None))
        else:
            hint = ("↑ и ↓ передвигают видео на одно место. Чтобы перенести дальше, нажмите видео, "
                    "затем то, перед которым его поставить. Изменения сохраняются сразу." +
                    (" Переставлять можно внутри одного номера урока." if sub["order"] == "lesson" else ""))
            if sub["undo"]:
                tool("↶ Отменить", self.editor_undo)
            if self.library.manual_order(sub["playlist"], sub["order"]):
                tool("Вернуть порядок сервиса" if sub["order"] == "custom" else "Сбросить поправки",
                     self.editor_reset)
        box.pack_start(label(hint, "hint", wrap=True), False, False, 0)
        if tools.get_children():
            box.pack_start(tools, False, False, 0)
        self.say("" if items else "В плейлисте нет доступных видео.")
        def add(item):
            # ↑ and ↓ step it, as Настройки of the shell orders the panel; a
            # tap on the row picks it for a longer way.
            row = Gtk.Box(spacing=12)
            row.get_style_context().add_class("chan")
            if item["entry_id"] == sub["pick"]:
                row.get_style_context().add_class("picked")
            pick = Gtk.Button()
            pick.get_style_context().add_class("open")
            pick._entry_id = item["entry_id"]
            inner = Gtk.Box(spacing=16)
            num = label("%d" % (item["position"] + 1), "csub")
            num.set_width_chars(4)
            num.set_xalign(1)
            inner.pack_start(num, False, False, 0)
            mini = Gtk.Image()
            mini.set_size_request(EDITOR_THUMB[0], EDITOR_THUMB[1])
            # Its list asks for the picture (channel_row tells why).
            row._pictures = lambda on: (self.thumbs.get(item.get("thumb"), mini, EDITOR_THUMB)
                                        if on else self.thumbs.drop(mini))
            inner.pack_start(mini, False, False, 0)
            title = label(item["title"], "ttl")
            title.set_ellipsize(3)  # Pango.EllipsizeMode.END
            inner.pack_start(title, True, True, 0)
            pick.add(inner)
            pick.connect("clicked", lambda _b, v=item: self.editor_tap(v))
            row.pack_start(pick, True, True, 0)
            for text, step, can in (("↑", -1, item["position"] > item["minimum"]),
                                    ("↓", 1, item["position"] < item["maximum"])):
                btn = Gtk.Button(label=text, sensitive=can)
                btn.set_tooltip_text("Выше" if step < 0 else "Ниже")
                btn.get_style_context().add_class("step")
                btn.set_valign(Gtk.Align.CENTER)
                btn.connect("clicked", lambda _b, v=item, d=step: self.editor_step(v, d))
                row.pack_start(btn, False, False, 0)
            return row

        # Drawn again after each move: made as far as before, or the place is lost.
        rows = self.lazy(items, add, spacing=6, at_least=sub["rows"].built if again and sub.get("rows") else 0)
        sub["rows"] = rows
        box.pack_start(rows.widget, False, False, 0)
        if again:
            self.keep_scroll(lambda: self.set_content(box))
        else:
            self.set_content(box)

    def editor_pick(self, ident):
        self.sub["pick"] = ident
        self.show_playlist_editor(again=True)

    def editor_tap(self, item):
        sub = self.sub
        if sub["pick"] is None:
            self.editor_pick(item["entry_id"])
        elif sub["pick"] == item["entry_id"]:
            self.editor_pick(None)
        else:
            old = next(v["position"] for v in sub["items"] if v["entry_id"] == sub["pick"])
            target = item["position"]
            self.editor_place(target - 1 if old < target else target)

    def editor_step(self, item, step):
        sub = self.sub
        sub["pick"] = None
        if self.editor_move(item["entry_id"], item["position"] + step):
            sub["undo"].append((item["entry_id"], item["position"]))
        self.show_playlist_editor(again=True)

    def editor_place(self, position):
        sub = self.sub
        ident, sub["pick"] = sub["pick"], None
        old = next(v["position"] for v in sub["items"] if v["entry_id"] == ident)
        if self.editor_move(ident, position):
            sub["undo"].append((ident, old))
        self.show_playlist_editor(again=True)

    def editor_move(self, ident, position):
        """Move and save at once; the next view opens a fresh draft."""
        sub = self.sub
        try:
            self.core.command("playlist_move", {"entity": sub["playlist"], "token": sub["token"],
                                               "entry_id": ident, "position": position})
            self.core.command("playlist_save", {"entity": sub["playlist"], "token": sub["token"]})
        except ValueError as exc:
            self.say(str(exc))
            return False
        finally:
            sub.pop("token", None)
        sub["changed"] = True
        return True

    def editor_undo(self):
        sub = self.sub
        ident, old = sub["undo"].pop()
        self.editor_move(ident, old)
        self.show_playlist_editor(again=True)

    def editor_reset(self):
        sub = self.sub
        try:
            result = self.core.query("reset_preview", {"entity": sub["playlist"], "order": sub["order"],
                                                       "what": "order"})
            if result.get("loading") or result.get("failed"):
                self.say("Не удалось проверить плейлист.")
                return
            text = ("Вернуть порядок сервиса? Ваши перестановки в этом плейлисте пропадут."
                    if sub["order"] == "custom" else "Сбросить поправки внутри уроков этого плейлиста?")
            if dialogs.ask(self.win, text, "Вернуть порядок сервиса" if sub["order"] == "custom"
                           else "Сбросить поправки") and self.sub is sub:
                if sub.get("token"):
                    self.core.command("playlist_cancel", {"entity": sub["playlist"], "token": sub.pop("token")})
                self.core.command("playlist_reset", {"token": result["token"]})
                sub.update(undo=[], pick=None, changed=True)
                self.show_playlist_editor(again=True)
        except ValueError as exc:
            self.say(str(exc))

    def finish_playlist_editor(self, _save=False):
        """Leaving the editor: what was moved is saved already; the playlist
        shows the order edited if anything was."""
        sub = self.sub
        if sub.get("token"):
            try:
                self.core.command("playlist_cancel", {"entity": sub["playlist"], "token": sub.pop("token")})
            except ValueError:
                pass
        self.playlist_order[sub["key"]] = sub["order"] if sub.get("changed") else sub["return_order"]
        self.show_playlist(sub["playlist"], sub["chan"])

    def _playlist_came(self, key, _error):
        if self.on_sub("playlist", key=key) and self.sub["order"] == "vk":
            self.show_playlist(self.sub["playlist"], self.sub["chan"], key[3], again=True,
                               previous=self.sub["previous"])

    def _playlist_all_came(self, key, _error):
        if self.on_sub("playlist_editor") and self.sub["key"] == key:
            self.show_playlist_editor(again=True)
        resume = self.pending_playlist_resume
        if resume and resume["key"] == key and self.sub is resume["sub"]:
            self.pending_playlist_resume = None
            if _error:
                self.say("Не удалось проверить плейлист. Прогресс сохранён; повторите при подключении.")
            else:
                self.playlist_resume_action(resume["sub"], resume["action"])
        pending = self.pending_playlist_play
        if pending and pending["key"] == key and self.sub is pending["sub"]:
            if _error:
                self.pending_playlist_play = None
                self.say("Не удалось загрузить очередь плейлиста: нет связи?")
            else:
                self.play_from_playlist(pending["video"], pending["sub"], pending.get("start_over", False), pending.get("start_at"))
        if (self.sub and self.sub["kind"] == "playlist"
                and self.sub["key"][:3] == key and self.sub["order"] != "vk"):
            self.show_playlist(self.sub["playlist"], self.sub["chan"], self.sub["key"][3],
                               again=True, previous=self.sub["previous"])

    def _channel_came(self, key, _error):
        if self.on_sub("channel", key=key):
            self.show_channel(self.sub["chan"], again=True)

    def playlist_resume(self, sub):
        """The «Продолжить» button (None without a video to go on from) and
        a note on where it goes on; what they say is the core's (views.resume)."""
        play = sub["result"]["play"]
        if not play:
            return None, ""
        bits = ["▶ " + play["caption"], play["title"]]
        if play["pos"]:
            bits.append(nice_duration(play["pos"]))
        btn = Gtk.Button(sensitive=play["enabled"])
        text = Gtk.Label(label=" · ".join(bits), xalign=0)
        text.set_ellipsize(3)  # Pango.EllipsizeMode.END
        btn.add(text)
        btn.get_style_context().add_class("find")
        btn._caption = play["caption"]
        btn.connect("clicked", lambda _b: self.playlist_resume_action(sub, play["action"]))
        return btn, play["note"]

    def playlist_actions(self, sub):
        """What ⋮ on a playlist offers, as (title, fn)."""
        obj = dict(sub["playlist"], owner_title=sub["chan"]["title"])
        return self.core_actions("playlist", obj, {"order": sub["order"]}, sub=sub)

    def menu(self, anchor, actions, status=""):
        """A popover of buttons under anchor; each closes it and acts."""
        pop = Gtk.Popover.new(anchor)
        pop.connect("closed", lambda p: p.destroy())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12)
        if status:
            box.pack_start(label(status, "hint", wrap=True), False, False, 0)
        for title, fn in actions:
            btn = Gtk.Button(label=title)
            btn.get_style_context().add_class("more")
            btn.connect("clicked", lambda _b, f=fn: (pop.popdown(), f()))
            box.pack_start(btn, False, False, 0)
        pop.add(box)
        pop.show_all()
        pop.popup()
        return pop

    def playlist_resume_action(self, sub, action):
        if self.sub is not sub:
            return
        key = sub["key"][:3]
        try:
            if action in ("play", "first"):
                result = self.core.playback_plan(playlist=sub["playlist"], order=sub["order"], resume=True,
                                                 start_over=action == "first")
                if result is not None:
                    self.play(result["video"], start_over=result["start_over"], start_at=result["start"])
                    return
            else:
                reset = action.startswith("reset")
                what = {"reset_tasks": "tasks", "reset_order": "order"}.get(action, "progress")
                result = self.core.query("reset_preview" if reset else "locate",
                                         {"entity": sub["playlist"], "order": sub["order"], "what": what})
                if result.get("failed"):
                    raise ValueError("Не удалось проверить плейлист. Прогресс сохранён.")
                if not result.get("loading"):
                    if reset:
                        text = ("Снять все отметки выполнения этого плейлиста?" if what == "tasks" else
                                "Сбросить ручной порядок и поправки внутри уроков этого плейлиста?" if what == "order" else
                                "Будут сброшены последнее видео и позиции просмотра всех видео "
                                       "плейлиста, также в других плейлистах, где они встречаются. "
                                       "Закладки, история и сортировка сохранятся.")
                        if dialogs.ask(self.win, text, {"tasks": "Сбросить выполнение", "order": "Сбросить ручной порядок"}.get(what, "Сбросить прогресс")):
                            if self.sub is sub:
                                self.pending_playlist_play = None
                                self.pending_playlist_resume = None
                                self.core.command("playlist_reset", {"token": result["token"]})
                                self.show_playlist(sub["playlist"], sub["chan"])
                                self.say({"tasks": "Выполнение сброшено.", "order": "Ручной порядок сброшен."}.get(what, "Прогресс плейлиста сброшен."))
                    elif result.get("video"):
                        self.show_playlist(sub["playlist"], sub["chan"], result["offset"],
                                           previous=tuple(result["previous"]), focus_video=result["video"])
                    else:
                        self.say("В плейлисте нет доступных видео. Прогресс сохранён.")
                    return
            self.pending_playlist_resume = {"sub": sub, "key": key, "action": action}
            self.say("Загружаю плейлист…")
        except ValueError as exc:
            self.say(str(exc))

    # --- bookmarks -------------------------------------------------------
    def bookmark_button(self, kind, obj, style="star"):
        btn = Gtk.Button()
        btn.get_style_context().add_class(style)
        btn.set_valign(Gtk.Align.CENTER)

        def update():
            saved = self.library.bookmarks.find(kind, obj)
            btn.set_label("★" if saved else "☆")
            (btn.get_style_context().add_class if saved else btn.get_style_context().remove_class)("saved")
            btn.set_tooltip_text("Действия с закладкой" if saved else "В закладки")

        def clicked(_btn):
            saved = self.library.bookmarks.find(kind, obj)
            if saved:
                self.bookmark_menu(btn, saved)
            else:
                self.core.command("bookmark_add", {"kind": kind, "entity": obj})
        update()
        btn._refresh = update
        btn.connect("clicked", clicked)
        # Every star on show follows a bookmark changed anywhere (library_changed).
        self.stars.add(btn)
        btn.connect("destroy", self.stars.discard)
        return btn

    def bookmark_menu(self, button, saved):
        """⋮ on a bookmark (or ★ on what is bookmarked): its state, then
        what the core offers for it."""
        status = self.bookmark_status(saved)[1]
        return self.menu(button, self.core_actions("bookmark", {"key": saved["key"]}), status)

    def bookmark_status(self, saved):
        links = saved["links"]
        if not links:
            return "", "Только на этом устройстве"
        notes = []
        for aid, link in links.items():
            name = link.get("account") or aid
            state = link["state"]
            if state == "error":
                note = link.get("error") or "Ошибка синхронизации"
            elif state == "pending":
                note = "Ожидает отправки"
            else:
                note = "Синхронизировано"
            active = any(s["aid"] == aid and self.library.bookmarks.enabled(aid)
                         for s in self.bookmark_sync.sessions.values())
            notes.append("%s · %s%s" % (name, note, "" if active else " · синхронизация выключена"))
        states = [v["state"] for v in links.values()]
        return ("☁ !" if "error" in states else "☁ ↻" if "pending" in states else "☁ ✓"), "\n".join(notes)

