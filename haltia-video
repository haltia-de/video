    def set_enabled(self, src, on):
        self.core.set_enabled(src.id, on)

    def _signin_changed(self, src, state):
        self._bind_core_collections()
        if self.on_sub("settings"):
            self.show_settings()

    def logout(self, src):
        if dialogs.ask(self.win, src.label, "Выйти из аккаунта"):
            self.signins[src.id].logout()

    def import_subscriptions(self, src):
        self.core.import_subscriptions(src.id)

    # --- channels ---------------------------------------------------------
    def library_changed(self, what):
        if what == "playlist_edits" and self.on_sub("playlist"):
            self.show_playlist(self.sub["playlist"], self.sub["chan"], self.sub["key"][3],
                               again=True, previous=self.sub["previous"])
        elif what == "tasks" and self.on_sub("playlist"):
            LazyList.refresh_all()  # the marks on the cards, in place
            self.playlist_head(self.sub)
        elif what == "bookmarks":
            for star in list(self.stars):
                star._refresh()
            self.redraw("bookmarks")
            self.redraw("home")
        elif what in ("history", "playlist_progress"):
            self.redraw("home")
        elif what == "position":
            LazyList.refresh_all()  # the strips on the cards, in place
            state = self.player.state
            if state is None or state["paused"]:
                self.redraw("home")  # «Продолжить просмотр»; not while one watches
        elif what == "follow":
            self.feed.invalidate()  # the new channels' videos are not in it yet
            if self.on_sub("channel"):
                self.show_channel(self.sub["chan"], again=True)
            self.redraw("channels")
        elif what == "details":
            LazyList.refresh_all()  # the channels' rows, in place
            if self.on_sub("channel"):
                self.show_channel(self.sub["chan"], again=True)
        elif what == "unfollow":
            self.redraw(self.page)  # Каналы, and a feed without the channel
            if self.on_sub("channel"):
                self.show_channel(self.sub["chan"], again=True)
        elif what == "settings":
            self.update_scope()

    def card_menu(self, video, anchor):
        """⋮ on a card, or a long press on it: the channel and the bookmark."""
        return self.menu(anchor, self.core_actions("video", video))

    def core_actions(self, kind, item, context=None, sub=None):
        """What the core offers on kind (views.actions), as (title, fn)."""
        return [(a["title"], lambda a=a: self.run_action(a, sub)) for a in self.core.actions(kind, item, context)]

    def run_action(self, action, sub=None):
        """One of the core's actions: its command (asked first, or offered
        back for a few seconds), or what the window does for its id."""
        if action.get("command"):
            confirm, undo = action.get("confirm"), action.get("undo")
            if confirm and not dialogs.ask(self.win, confirm["text"], confirm["button"]):
                return False
            try:
                self.core.command(action["command"], action["params"])
            except ValueError as exc:
                self.say(str(exc))
                return False
            if undo:
                self.notice(undo["notice"], "Вернуть", lambda: self.core.command(undo["command"], undo["params"]))
            elif action["id"] == "follow":
                self.say("Вы подписались на «%s»." % action["params"]["entity"].get("title", ""))
            return True
        name = action["id"]
        if name == "channel":
            self.show_channel(action["entity"])
        elif name == "add_link":
            self.bookmark_link_page()
        elif name == "filter":
            self.bookmark_filter(action["field"], action["value"])
        elif name == "edit_order":
            self.show_playlist_editor(sub["playlist"], sub["chan"], action["order"], return_order=action["return_order"])
        elif name == "locate":
            self.playlist_resume_action(sub, "locate")
        elif name == "reset":
            self.playlist_resume_action(sub, {"progress": "reset", "tasks": "reset_tasks",
                                              "order": "reset_order"}[action["what"]])
        return True

    def unfollow(self, chan):
        """The channel's «Отписаться» (Каналы' ✕, its page, a search):
        asked first, or offered back at its place in the list."""
        action = next(a for a in self.core.actions("channel", chan) if a["id"] in ("unfollow", "follow"))
        if action["id"] == "unfollow":
            self.run_action(action)

    def notice(self, text, button, fn, seconds=5):
        self.toast_text.set_text(text)
        self.toast_btn.set_label(button)
        self.toast_fn = fn
        self.toast.show()
        self.toast_serial += 1
        serial = self.toast_serial

        def hide():
            if self.toast_serial == serial:
                self.toast.hide()
            return False
        GLib.timeout_add_seconds(seconds, hide)

    def toast_clicked(self, *_a):
        self.toast.hide()
        fn, self.toast_fn = self.toast_fn, None
        if fn:
            fn()

    # --- playing ----------------------------------------------------------
    def play(self, video, start_over=False, start_at=None):
        self.pending_playlist_play = None
        src = self.sources.get(video["source"])
        if not src:
            return
        if self.sub and self.sub["kind"] == "playlist" and hasattr(src, "stream"):
            self.play_from_playlist(video, self.sub, start_over, start_at)
            return
        try:
            stream = getattr(src, "stream", None)
            context = self.sub["playlist"] if self.sub and self.sub["kind"] == "playlist" else None
            self.player.open(video, src.watch_url(video), start=None if start_over else start_at if start_at is not None else self.library.resume_at(video),
                             ytdl=getattr(src, "ytdl_options", dict)(),
                             resolve=stream and (lambda fmt: stream(video, fmt)),
                             resolve_desktop=getattr(src, "resolve_on_desktop", False), playlist=context)
        except OSError:
            self.say("Нет проигрывателя (haltia-vplay или mpv).")

    def play_from_playlist(self, video, sub, start_over=False, start_at=None):
        try:
            plan = self.core.playback_plan(video, sub["playlist"], sub["order"], start_over=start_over)
            if plan is None:
                self.pending_playlist_play = {"key": sub["key"][:3], "sub": sub,
                                              "video": video, "start_over": start_over, "start_at": start_at}
                self.say("Загружаю плейлист для проигрывателя…")
                return
            self.pending_playlist_play = None
            src = self.sources[video["source"]]
            self.player.open_playlist(plan["queue"], plan["index"], src.stream,
                                      lambda v: None if start_over and v is plan["video"]
                                      else self.library.resume_at(v), playlist=sub["playlist"], order=sub["order"], start_at=start_at)
        except (OSError, ValueError) as exc:
            self.say(str(exc))

    def stop_playback(self):
        self.pending_playlist_play = None
        self.pending_playlist_resume = None
        self.player.stop()

    def note_played(self, state):
        self.core.note_local_played(state)

    def make_bar(self):
        """What plays, below the cards: haltia-vplay pauses when one leaves it,
        so here it waits to be watched on, from where the slider says."""
        bar = Gtk.Box(spacing=16)
        bar.get_style_context().add_class("bar")
        bar.set_no_show_all(True)
        opener = Gtk.EventBox()
        head = Gtk.Box(spacing=16)
        self.bar_thumb = Gtk.Image()
        self.bar_thumb.set_size_request(128, 72)
        head.pack_start(self.bar_thumb, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        text.set_valign(Gtk.Align.CENTER)
        self.bar_title = label("", "ttl")
        self.bar_title.set_ellipsize(3)  # Pango.EllipsizeMode.END
        self.bar_title.set_max_width_chars(30)
        self.bar_sub = label("", "sub")
        self.bar_sub.set_ellipsize(3)
        text.pack_start(self.bar_title, False, False, 0)
        text.pack_start(self.bar_sub, False, False, 0)
        head.pack_start(text, False, False, 0)
        opener.add(head)
        tap = Gtk.GestureMultiPress(widget=opener)
        tap.connect("released", lambda *_a: self.watch_on())
        opener._gesture = tap
        bar.pack_start(opener, False, False, 0)
        self.bar_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.bar_scale.set_draw_value(False)
        self.bar_scale.set_valign(Gtk.Align.CENTER)
        self.bar_scale.connect("button-press-event", lambda *_a: setattr(self, "seeking", True))
        self.bar_scale.connect("button-release-event", self.on_bar_seek)
        bar.pack_start(self.bar_scale, True, True, 0)
        self.bar_watch = Gtk.Button(label="▶ Смотреть")
        self.bar_watch.get_style_context().add_class("watch")
        self.bar_watch.set_valign(Gtk.Align.CENTER)
        self.bar_watch.connect("clicked", lambda *_a: self.watch_on())
        bar.pack_start(self.bar_watch, False, False, 0)
        close = Gtk.Button(label="✕")
        close.set_tooltip_text("Остановить")
        close.get_style_context().add_class("close")
        close.set_valign(Gtk.Align.CENTER)
        close.connect("clicked", lambda *_a: self.stop_playback())
        bar.pack_start(close, False, False, 0)
        self.bar = bar
        self.bar_video = None
        return bar

    def note_position(self, state):
        self.core.note_local_position(state)

    def watch_on(self):
        state = self.player.state
        if not state:
            return
        if state["paused"]:
            self.player.play()
            self.player.show()
        else:
            self.player.toggle()  # mpv on a desktop does not pause by itself

    def on_bar_seek(self, *_a):
        self.seeking = False
        self.player.seek(self.bar_scale.get_value())
        return False

    def show_bar(self, state):
        if state is None:
            self.bar.hide()
            self.bar_video = None
            return
        video = state["video"]
        if video is not self.bar_video:
            self.bar_video = video
            self.bar_title.set_text(video["title"])
            self.bar_thumb.clear()
            self.thumbs.get(video.get("thumb"), self.bar_thumb, (128, 72))
        pos, dur = state["pos"], state["duration"]
        when = ("%s из %s" % (nice_duration(pos) or "0:00", nice_duration(dur)) if dur
                else "загрузка…" + (" с %s" % nice_duration(state["start"])
                                     if state.get("start") else ""))
        bits = [video.get("channel") or "", "на паузе" if state["paused"] else "", when]
        self.bar_sub.set_text(" · ".join(b for b in bits if b))
        if dur and not self.seeking:
            self.bar_scale.set_range(0, max(dur, 1))
            self.bar_scale.set_value(pos or 0)
        self.bar_scale.set_sensitive(bool(dur))
        self.bar_watch.set_label("▶ Смотреть" if state["paused"] else "⏸")
        self.bar.set_no_show_all(False)  # kept hidden by the window's show_all till now
        self.bar.show_all()

    # --- background work --------------------------------------------------
    def work(self, func, *args, done):
        self.runtime.work(func, *args, done=done)


