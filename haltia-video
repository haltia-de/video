            self.player.play()
            self.player.show()
        else:
            self.player.toggle()  # mpv on a desktop does not pause by itself

    def on_bar_seek(self, *_a):
        self.seeking = False
        self.player.seek(self.bar_scale.get_value())
        return False

    def show_bar(self, state):
        if state is None:
            self.bar.hide()
            self.bar_video = None
            return
        video = state["video"]
        if video is not self.bar_video:
            self.bar_video = video
            self.bar_title.set_text(video["title"])
            self.bar_thumb.clear()
            self.thumbs.get(video.get("thumb"), self.bar_thumb, (128, 72))
        pos, dur = state["pos"], state["duration"]
        when = ("%s из %s" % (nice_duration(pos) or "0:00", nice_duration(dur)) if dur
                else "загрузка…" + (" с %s" % nice_duration(state["start"])
                                     if state.get("start") else ""))
        bits = [video.get("channel") or "", "на паузе" if state["paused"] else "", when]
        self.bar_sub.set_text(" · ".join(b for b in bits if b))
        if dur and not self.seeking:
            self.bar_scale.set_range(0, max(dur, 1))
            self.bar_scale.set_value(pos or 0)
        self.bar_scale.set_sensitive(bool(dur))
        self.bar_watch.set_label("▶ Смотреть" if state["paused"] else "⏸")
        self.bar.set_no_show_all(False)  # kept hidden by the window's show_all till now
        self.bar.show_all()

    # --- background work --------------------------------------------------
    def work(self, func, *args, done):
        self.runtime.work(func, *args, done=done)


if __name__ == "__main__":
    if sys.platform.startswith("linux"):
        renamed.move_old()  # before the Library and the sources open their files
    sys.exit(Video().run(sys.argv))
