def nice_duration(sec):
    if not sec:
        return ""
    sec = int(sec)
    if sec >= 3600:
        return "%d:%02d:%02d" % (sec // 3600, sec // 60 % 60, sec % 60)
    return "%d:%02d" % (sec // 60, sec % 60)


def plural(n, one, few, many):
    if n % 10 == 1 and n % 100 != 11:
        return one
    if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14:
        return few
    return many


def nice_subscribers(n):
    if n is None:
        return ""
    if n >= 1000:
        num, unit = (n / 1e6, "млн") if n >= 10 ** 6 else (n / 1e3, "тыс.")
        text = ("%d" % num) if num >= 100 else ("%.1f" % num).rstrip("0").rstrip(".")
        return "%s %s подписчиков" % (text.replace(".", ","), unit)
    return "%d %s" % (n, plural(n, "подписчик", "подписчика", "подписчиков"))


# A service's empty date (0001-01-01, 1970) is no date: shown, it read
# «новое видео 01.01.0001».
OLDEST_DATE = 1104537600  # 2005-01-01, before which no video here was made


def nice_age(ts):
    if not ts or ts < OLDEST_DATE:
        return ""
    days = int((time.time() - ts) // 86400)
    if days <= 0:
        hours = max(1, int((time.time() - ts) // 3600))
        return "%d ч назад" % hours
    if days == 1:
        return "вчера"
    if days < 7:
        return "%d %s назад" % (days, plural(days, "день", "дня", "дней"))
    if days < 30:
        weeks = days // 7
        return "%d %s назад" % (weeks, plural(weeks, "неделю", "недели", "недель"))
    return time.strftime("%d.%m.%Y", time.localtime(ts))


def without_links(text):
    """A channel's description without its links (a line of addresses
    and registration numbers told nothing in two lines)."""
    return " ".join(re.sub(r"(https?://|www\.)\S+", "", text or "").split())


