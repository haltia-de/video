    def show_home(self):
        """One row of each section the person keeps on Главная, and «Все →»
        for the rest of it: an overview, and fewer pictures for the B8000.
        What the sections hold is the core's, the same as the browser's."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        row = self.columns()
        for section in self.core.query("home")["sections"]:
            more = section["more"]
            go = None
            if more and (section["always"] or section["total"] > row):
                go = self.all_button(lambda m=more: self.open_more(m))
            self.section(box, section["title"], go)
            if section["hint"]:
                box.pack_start(label(section["hint"], "hint", wrap=True), False, False, 0)
            elif section["kind"] == "playlists":
                box.pack_start(self.playlist_tiles(section["items"][:row]), False, False, 0)
            else:
                box.pack_start(self.grid(section["items"][:row]), False, False, 0)
