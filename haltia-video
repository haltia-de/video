    def playlist_card(self, playlist, chan, cursor=None):
        """A playlist as a card: the service's cover (or, begun, the video it
        stopped at), its name and size; a tap opens it. Begun, it also tells
        where it stopped and offers «Продолжить»."""
        size = self.card_size()
        tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        tile.get_style_context().add_class("card")
        open_btn = Gtk.Button()
        open_btn.get_style_context().add_class("open")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        over = Gtk.Overlay(halign=Gtk.Align.CENTER)
        image = Gtk.Image()
        image.set_size_request(*size)
        over.add(image)
        thumb = playlist.get("thumb") or (cursor and cursor["video"].get("thumb"))
        if thumb:
            # Its list asks for the cover (channel_row tells why).
            tile._pictures = lambda on: self.thumbs.get(thumb, image, size) if on else self.thumbs.drop(image)
        else:
            image.get_style_context().add_class("nocover")
            image.set_from_icon_name("view-list-symbolic", Gtk.IconSize.DIALOG)
        corner = Gtk.Box(halign=Gtk.Align.END, valign=Gtk.Align.START, margin=8)
        corner.pack_start(self.bookmark_button("playlist", dict(playlist, owner_title=chan["title"]), "pic"),
                          False, False, 0)
        over.add_overlay(corner)
        inner.pack_start(over, False, False, 0)
        name = label(playlist.get("title") or "Плейлист", "ttl", wrap=True)
        name.set_lines(2)
        name.set_ellipsize(3)  # Pango.EllipsizeMode.END
        name.set_margin_start(12)
        name.set_margin_end(12)
        inner.pack_start(name, False, False, 0)
        bits = []
        if playlist.get("count"):
            bits.append("%d видео" % playlist["count"])
        if cursor:
            video = cursor["video"]
            pos = self.library.position(video) or {}
            bits.append(" ".join(b for b in (video.get("label") or video.get("title"), nice_duration(pos.get("pos"))) if b))
        if bits:
            sub = label(" · ".join(bits), "sub")
            sub.set_ellipsize(3)
            sub.set_margin_start(12)
            sub.set_margin_end(12)
            inner.pack_start(sub, False, False, 0)
        open_btn.add(inner)
        open_btn.connect("clicked", lambda _b: self.show_playlist(playlist, chan))
        tile.pack_start(open_btn, False, False, 0)
        if cursor:
            seen = self.library.progress(cursor["video"])
            if seen:
                tile.pack_start(Gtk.ProgressBar(fraction=seen), False, False, 0)
            go = Gtk.Button(label="▶ Продолжить")
            go.get_style_context().add_class("find")
            go.set_margin_start(12)
            go.set_margin_end(12)
            go.set_margin_bottom(4)
            go.connect("clicked", lambda _b: self.continue_playlist(playlist, chan))
            tile.pack_start(go, False, False, 0)
        return tile

