                text.pack_start(label("2. Или откройте в его браузере %s и введите код:" % urls[0], "ttl", wrap=True),
                                False, False, 0)
                text.pack_start(label(pending["code"], "code"), False, False, 0)
                text.pack_start(label("Код одноразовый и действует до %s." %
                                      time.strftime("%H:%M", time.localtime(pending["until"])), "csub"),
                                False, False, 0)
                steps.pack_start(text, True, True, 0)
                c.pack_start(steps, False, False, 0)
