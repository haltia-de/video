    def reload_playlist_editor(self):
        sub = self.sub
        if sub.get("token"):
            self.core.command("playlist_cancel", {"entity": sub["playlist"], "token": sub.pop("token")})
        self.show_playlist_editor(again=True)

    def move_playlist_entry(self, ident, position):
        sub = self.sub
        try:
            self.core.command("playlist_move", {"entity": sub["playlist"], "token": sub["token"],
                                               "entry_id": ident, "position": position})
            sub.update(offset=(position // 30) * 30, target=ident)
            self.show_playlist_editor(again=True)
        except ValueError as exc:
            self.say(str(exc))

    def finish_playlist_editor(self, save):
        sub = self.sub
        try:
            if sub.get("token"):
                self.core.command("playlist_save" if save else "playlist_cancel",
                                  {"entity": sub["playlist"], "token": sub["token"]})
                sub.pop("token", None)
            self.playlist_order[sub["key"]] = sub["order"] if save else sub["return_order"]
            self.show_playlist(sub["playlist"], sub["chan"])
        except ValueError as exc:
            self.say(str(exc))

    def _playlist_came(self, key, _error):
        if self.on_sub("playlist", key=key) and self.sub["order"] == "vk":
            self.show_playlist(self.sub["playlist"], self.sub["chan"], key[3], again=True,
                               previous=self.sub["previous"])

    def _playlist_all_came(self, key, _error):
        if self.on_sub("playlist_editor") and self.sub["key"] == key:
            self.show_playlist_editor(again=True)
        resume = self.pending_playlist_resume
        if resume and resume["key"] == key and self.sub is resume["sub"]:
            self.pending_playlist_resume = None
            if _error:
                self.say("Не удалось проверить плейлист. Прогресс сохранён; повторите при подключении.")
            else:
                self.playlist_resume_action(resume["sub"], resume["action"])
        pending = self.pending_playlist_play
        if pending and pending["key"] == key and self.sub is pending["sub"]:
            if _error:
                self.pending_playlist_play = None
                self.say("Не удалось загрузить очередь плейлиста: нет связи?")
            else:
                self.play_from_playlist(pending["video"], pending["sub"], pending.get("start_over", False), pending.get("start_at"))
        if (self.sub and self.sub["kind"] == "playlist"
                and self.sub["key"][:3] == key and self.sub["order"] != "vk"):
            self.show_playlist(self.sub["playlist"], self.sub["chan"], self.sub["key"][3],
                               again=True, previous=self.sub["previous"])

    def _channel_came(self, key, _error):
        if self.on_sub("channel", key=key):
            self.show_channel(self.sub["chan"], again=True)

