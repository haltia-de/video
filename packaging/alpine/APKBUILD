# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-video
pkgver=2.11.2
pkgrel=0
pkgdesc="Видео: videos from YouTube and VK Video (GTK 3)"
url="https://github.com/haltia-de/video"
# haltia-vplay, the video window, is C.
arch="all"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 py3-haltia-kit>=2.2.0 py3-pillow yt-dlp quickjs py3-qrcode"
# The original 32-bit tablet keeps the native UI without web dependencies.
if [ "$CARCH" != "armv7" ]; then
	depends="$depends py3-aiohttp ffmpeg"
fi
makedepends="pkgconf mpv-dev pango-dev cairo-dev wayland-dev wayland-protocols glib-dev"
# b8k-video before ADR 0004; the old names are links until 3.0.
provides="b8k-video=$pkgver-r$pkgrel"
replaces="b8k-video"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/video/archive/v$pkgver.tar.gz"
# GitHub names the archive's folder after the repository.
builddir="$srcdir/video-$pkgver"

build() {
	local p=/usr/share/wayland-protocols n
	for n in stable/xdg-shell/xdg-shell stable/viewporter/viewporter; do
		wayland-scanner client-header "$p/$n.xml" "vplay/${n##*/}-client-protocol.h"
		wayland-scanner private-code "$p/$n.xml" "vplay/${n##*/}-protocol.c"
	done
	# shellcheck disable=SC2046 # pkg-config prints separate flags
	${CC:-cc} $CFLAGS -Wall -Wextra -Ivplay -o vplay/haltia-vplay \
		$(pkg-config --cflags pangocairo wayland-client gio-unix-2.0 mpv) \
		vplay/haltia-vplay.c vplay/xdg-shell-protocol.c vplay/viewporter-protocol.c \
		$(pkg-config --libs pangocairo wayland-client gio-unix-2.0 mpv) -lm $LDFLAGS
}

check() {
	python3 -m unittest
}

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
