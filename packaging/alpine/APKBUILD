# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=b8k-video
pkgver=1.12.4
pkgrel=0
pkgdesc="Видео: videos from YouTube and VK Video in large cards (GTK 3)"
url="https://github.com/trudenboy/b8k-video"
# b8k-vplay, the video window, is C.
arch="all"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 py3-b8k-compat py3-pillow yt-dlp quickjs py3-qrcode"
makedepends="pkgconf mpv-dev pango-dev cairo-dev wayland-dev wayland-protocols glib-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/trudenboy/b8k-video/archive/v$pkgver.tar.gz"

build() {
	local p=/usr/share/wayland-protocols n
	for n in stable/xdg-shell/xdg-shell stable/viewporter/viewporter; do
		wayland-scanner client-header "$p/$n.xml" "vplay/${n##*/}-client-protocol.h"
		wayland-scanner private-code "$p/$n.xml" "vplay/${n##*/}-protocol.c"
	done
	# shellcheck disable=SC2046 # pkg-config prints separate flags
	${CC:-cc} $CFLAGS -Wall -Wextra -Ivplay -o vplay/b8k-vplay \
		$(pkg-config --cflags pangocairo wayland-client gio-unix-2.0 mpv) \
		vplay/b8k-vplay.c vplay/xdg-shell-protocol.c vplay/viewporter-protocol.c \
		$(pkg-config --libs pangocairo wayland-client gio-unix-2.0 mpv) -lm $LDFLAGS
}

check() {
	python3 -m unittest
}

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
